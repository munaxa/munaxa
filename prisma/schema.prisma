// A parent-submitted leave (planned) or absence (excuse) request for one of their children.
// Reviewed (approved/rejected) by school staff holding leave:approve.
model LeaveRequest {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  studentId     String             @db.Uuid
  requestedById String?            @db.Uuid
