  SCHOOL
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum DayOfWeek {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum ScheduleType {
  REGULAR
  RAMADAN
}

enum ExceptionType {
  CANCELLATION
  SUBSTITUTION
  REPLACEMENT
  HOLIDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TeacherAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
}

enum AttendanceMethod {
