// ----------------------------------------------------------------------------
// Notification platform (Push + Email only — no SMS/WhatsApp/Telegram)
// ----------------------------------------------------------------------------

// Channel-independent dispatch priority. Drives PriorityEngine channel selection + escalation.
enum NotificationPriority {
  CRITICAL // push + email immediately (emergencies, security, OTP)
  HIGH // push first; escalate to email if unread
  NORMAL // push only
  LOW // email only (digests/newsletters)
}

// Lifecycle of the in-app Notification (source of truth for the center).
enum NotificationStatus {
  PENDING // created, awaiting channel dispatch
  SENT // handed to at least one channel
  DELIVERED // a provider confirmed delivery
  READ // user opened it
  FAILED // all channels failed
  ARCHIVED // user archived it
}

// Functional grouping — mirrors the per-category preference matrix.
enum NotificationCategory {
  ATTENDANCE
  FINANCE
  ACADEMIC
  BEHAVIOR
  ANNOUNCEMENT
  SYSTEM
}

// Concrete delivery channels Munaxa supports.
enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

// Per-attempt delivery outcome recorded against a channel send.
enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  SKIPPED // suppressed by preference / kill-switch
}

// Parent portal: a leave (planned future absence) or an explanation/excuse for a past absence.
enum LeaveRequestType {
  LEAVE
  ABSENCE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Parent-Teacher Meeting slot lifecycle.
enum PtmSlotStatus {
  OPEN
  BOOKED
  CANCELLED
  COMPLETED
}

enum PtmBookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

// Document vault classification.
enum DocumentCategory {
  REPORT_CARD
  CERTIFICATE
  MEDICAL
  ID_DOCUMENT
  PERMISSION_SLIP
  OTHER
}

// Student app: learning resource kind. Munaxa is not an LMS — LINK/VIDEO deep-link out
// (Google Classroom / MS Teams), FILE/DOCUMENT are stored in S3 via the StorageService.
enum ResourceType {
  LINK
  FILE
  VIDEO
  DOCUMENT
}

// Tenant database promotion (pool → dedicated/silo) wizard state.
enum TenantDbStatus {
  REQUESTED
  PROVISIONED
  MIGRATED
  DATA_COPIED
  VERIFIED
  ACTIVE
  FAILED
  ABORTED
}

// Gamification: how an achievement is earned. STREAK/TOTAL are auto-awarded from attendance;
// ACADEMIC/GENERAL are awarded manually by staff.
enum AchievementCategory {
  ATTENDANCE_STREAK
  ATTENDANCE_TOTAL
  ACADEMIC
  GENERAL
}

// Advanced modules (Phase 14) — all gated by per-tenant feature flags, disabled by default.
enum BookLoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum InventoryTxnType {
  IN
  OUT
  ADJUST
}

enum ClinicOutcome {
  RESOLVED
  SENT_HOME
  REFERRED
  HOSPITALIZED
}

enum RoleKey {
  // Platform plane
  PlatformOwner
  PlatformAdmin
  SupportAgent
  // School plane
  SchoolAdmin
  Principal
  VicePrincipal
  FinanceOfficer
  Accountant
  Teacher
  Secretary
  Receptionist
  Registrar
  Counselor
  HR
  Nurse
  Librarian
  StoreKeeper
  FleetAdmin
  BusSupervisor
  Parent
  Student
}

// ----------------------------------------------------------------------------
// Tenancy
// ----------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  type      TenantType   @default(SCHOOL)
  name      String
  slug      String       @unique
  status    TenantStatus @default(PROVISIONING)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)

  schools                  School[]
  campuses                 Campus[]
  academicYears            AcademicYear[]
  semesters                Semester[]
  grades                   Grade[]
  classrooms               Classroom[]
  sections                 Section[]
  users                    User[]
  roles                    Role[]
  userRoles                UserRole[]
  refreshTokens            RefreshToken[]
  passwordResets           PasswordResetToken[]
  passwordResetAudits      PasswordResetAudit[]
  students                 Student[]
  parents                  Parent[]
  teachers                 Teacher[]
  employees                Employee[]
  parentStudents           ParentStudent[]
  teacherSections          TeacherSection[]
  timetableSlots           TimetableSlot[]
  scheduleExceptions       ScheduleException[]
  timetableConfigs         TimetableConfig[]
  studentAttendance        StudentAttendance[]
  teacherAttendance        TeacherAttendance[]
  homework                 Homework[]
  homeworkAttachments      HomeworkAttachment[]
  behaviorLogs             BehaviorLog[]
  gradeRecords             GradeRecord[]
  feePlans                 FeePlan[]
  charges                  Charge[]
  transactions             Transaction[]
  announcements            Announcement[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  notificationTemplates    NotificationTemplate[]
  notificationDeliveries   NotificationDelivery[]
  notificationAudits       NotificationAudit[]
  notificationSettings     NotificationSettings?
  deviceTokens             DeviceToken[]
  featureFlags             FeatureFlag[]
  auditLogs                AuditLog[]
  leaveRequests            LeaveRequest[]
  ptmSlots                 PtmSlot[]
  ptmBookings              PtmBooking[]
  documents                Document[]
  resources                Resource[]
  achievements             Achievement[]
  studentAchievements      StudentAchievement[]
  studentGamification      StudentGamification[]
  busRoutes                BusRoute[]
  buses                    Bus[]
  busStops                 BusStop[]
  busAssignments           StudentBusAssignment[]
  libraryBooks             LibraryBook[]
  bookLoans                BookLoan[]
  inventoryItems           InventoryItem[]
  inventoryTxns            InventoryTransaction[]
  medicalRecords           StudentMedicalRecord[]
  clinicVisits             ClinicVisit[]
  tenantDatabase           TenantDatabase?
  einvoiceSettings         EInvoiceSettings?
  einvoiceCredentials      EInvoiceCredential[]
  einvoiceCounter          EInvoiceCounter?
  einvoiceDocuments        EInvoiceDocument[]
  einvoiceLogs             EInvoiceLog[]
  feeAdjustments           FeeAdjustment[]
  paymentAllocations       PaymentAllocation[]
  refunds                  Refund[]
  billingProfiles          StudentBillingProfile[]
  paymentReminders         PaymentReminder[]
  presenceEvents           StudentPresenceEvent[]
  busAttendanceEvents      BusAttendanceEvent[]
  attendanceSourceConfig   AttendanceSourceConfig?
  studentCards             StudentCard[]
  studentVaccines          StudentVaccine[]
  gradeFeeSchedules        GradeFeeSchedule[]
  transportFares           TransportFare[]
  discountRules            DiscountRule[]
  billingPolicy            BillingPolicy?
  feeItems                 FeeItem[]
  gradeFeeItems            GradeFeeItem[]
  enrollmentQuotes         EnrollmentQuote[]
  enrollmentQuoteItems     EnrollmentQuoteItem[]
  enrollments              Enrollment[]
  feeModifications         FeeModification[]
  feeModificationApprovals FeeModificationApproval[]
  financialArrangements    FinancialArrangement[]
  registrationCommitments  RegistrationCommitment[]

  @@index([status])
}

// ----------------------------------------------------------------------------
// School structure
// ----------------------------------------------------------------------------

model School {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  nameEn        String
  nameAr        String
  moeSchoolCode String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campuses Campus[]

  @@unique([tenantId, moeSchoolCode])
  @@index([tenantId])
}

model Campus {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  schoolId  String    @db.Uuid
  nameEn    String
  nameAr    String
  address   String?
  phone     String?
  isMain    Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYears   AcademicYear[]
  grades          Grade[]
  classrooms      Classroom[]
  timetableConfig TimetableConfig?

  @@index([tenantId])
  @@index([tenantId, schoolId])
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  campusId  String   @db.Uuid
  name      String // e.g. "2025/2026"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus           Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  semesters        Semester[]
  feeSchedules     GradeFeeSchedule[]
  transportFares   TransportFare[]
  gradeFeeItems    GradeFeeItem[]
  enrollmentQuotes EnrollmentQuote[]
  enrollments      Enrollment[]

  @@unique([tenantId, campusId, name])
  @@index([tenantId, campusId])
}

model Semester {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  academicYearId String   @db.Uuid
  name           String
  sequence       Int
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeRecords GradeRecord[]

  @@unique([tenantId, academicYearId, sequence])
  @@index([tenantId, academicYearId])
}

model Grade {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  campusId  String   @db.Uuid
  nameEn    String
  nameAr    String
  level     Int // ordinal, e.g. KG=0, G1=1 ...
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus           Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sections         Section[]
  resources        Resource[]
  feeSchedules     GradeFeeSchedule[]
  gradeFeeItems    GradeFeeItem[]
  enrollmentQuotes EnrollmentQuote[]
  enrollments      Enrollment[]

  @@unique([tenantId, campusId, level])
  @@index([tenantId, campusId])
}

model Classroom {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  campusId  String   @db.Uuid
  name      String
  capacity  Int?
  building  String?
  floor     String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus             Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sections           Section[]
  timetableSlots     TimetableSlot[]
  scheduleExceptions ScheduleException[]

  @@unique([tenantId, campusId, name])
  @@index([tenantId, campusId])
}

model Section {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  gradeId     String   @db.Uuid
  classroomId String?  @db.Uuid
  name        String // e.g. "A", "B"
  capacity    Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grade              Grade               @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  classroom          Classroom?          @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  students           Student[]
  teacherSections    TeacherSection[]
  timetableSlots     TimetableSlot[]
  scheduleExceptions ScheduleException[]
  attendance         StudentAttendance[]
  homework           Homework[]
  gradeRecords       GradeRecord[]
  announcements      Announcement[]
  ptmSlots           PtmSlot[]
  resources          Resource[]

  @@unique([tenantId, gradeId, name])
  @@index([tenantId, gradeId])
  @@index([tenantId, classroomId])
}

// ----------------------------------------------------------------------------
// People management
// ----------------------------------------------------------------------------

model Student {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  userId           String?       @unique @db.Uuid
  moeStudentNumber String? // Ministry of Education student number
  nationalId       String? // Jordanian National ID (Raqam Watani)
  firstNameEn      String
  lastNameEn       String
  firstNameAr      String
  lastNameAr       String
  // Full Arab/MoE name parts (given · father · grandfather · family). Optional/back-compat.
  fatherNameEn     String?
  fatherNameAr     String?
  thirdNameEn      String?
  thirdNameAr      String?
  dateOfBirth      DateTime?     @db.Date
  gender           Gender?
  sectionId        String?       @db.Uuid
  qrCode           String        @unique
  status           StudentStatus @default(ACTIVE)
  enrollmentDate   DateTime      @default(now()) @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?     @db.Timestamptz(6)

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  section               Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parentLinks           ParentStudent[]
  attendance            StudentAttendance[]
  behaviorLogs          BehaviorLog[]
  gradeRecords          GradeRecord[]
  charges               Charge[]
  transactions          Transaction[]
  leaveRequests         LeaveRequest[]
  ptmBookings           PtmBooking[]
  documents             Document[]
  achievements          StudentAchievement[]
  gamification          StudentGamification?
  busAssignments        StudentBusAssignment[]
  bookLoans             BookLoan[]
  medicalRecord         StudentMedicalRecord?
  clinicVisits          ClinicVisit[]
  einvoiceDocuments     EInvoiceDocument[]
  adjustments           FeeAdjustment[]
  refunds               Refund[]
  billingProfile        StudentBillingProfile?
  paymentReminders      PaymentReminder[]
  presenceEvents        StudentPresenceEvent[]
  busAttendanceEvents   BusAttendanceEvent[]
  cards                 StudentCard[]
  vaccines              StudentVaccine[]
  enrollments           Enrollment[]
  enrollmentQuotes      EnrollmentQuote[]
  financialArrangements FinancialArrangement[]

  @@unique([tenantId, moeStudentNumber])
  @@unique([tenantId, nationalId])
  @@index([tenantId])
  @@index([tenantId, sectionId])
  @@index([tenantId, status])
}

model Parent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String?   @unique @db.Uuid
  firstNameEn String
  lastNameEn  String
  firstNameAr String
  lastNameAr  String
  phone       String?
  phoneAlt    String?
  email       String?
  nationalId  String?
  occupation  String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentLinks ParentStudent[]

  // Uniqueness is enforced by PARTIAL unique indexes (WHERE "deletedAt" IS NULL) created in
  // migration 20260622160000_parent_unique_partial — NOT by Prisma @@unique — so that a
  // soft-deleted parent does not reserve a mobile/national-id and the same person can be
  // re-added later. Do not add @@unique here (it would create plain indexes and reintroduce
  // the "record already exists" bug against deleted rows).
  @@index([tenantId])
}

model Teacher {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  userId         String?          @unique @db.Uuid
  employeeNumber String?
  firstNameEn    String
  lastNameEn     String
  firstNameAr    String
  lastNameAr     String
  specialization String?
  status         EmploymentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?        @db.Timestamptz(6)

  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  sections               TeacherSection[]
  timetableSlots         TimetableSlot[]
  exceptionReplacements  ScheduleException[] @relation("ExceptionTeacher")
  exceptionSubstitutions ScheduleException[] @relation("ExceptionSubstitute")
  attendance             TeacherAttendance[]
  ptmSlots               PtmSlot[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
}

model Employee {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  userId      String?          @unique @db.Uuid
  firstNameEn String
  lastNameEn  String
  firstNameAr String
  lastNameAr  String
  jobTitle    String
  department  String?
  status      EmploymentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?        @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model ParentStudent {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  parentId  String         @db.Uuid
  studentId String         @db.Uuid
  relation  ParentRelation
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

model TeacherSection {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  teacherId String   @db.Uuid
  sectionId String   @db.Uuid
  subject   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teacherId])
  @@index([sectionId])
}

// ----------------------------------------------------------------------------
// Identity & Access (IAM)
// ----------------------------------------------------------------------------

model User {
  id                     String     @id @default(uuid()) @db.Uuid
  tenantId               String     @db.Uuid
  firebaseUid            String?    @unique
  email                  String
  // Optional login handle (e.g. for students/parents without email). Unique per tenant.
  username               String?
  phone                  String?
  nationalId             String? // Jordanian National ID (Raqam Watani)
  firstNameEn            String?
  lastNameEn             String?
  firstNameAr            String?
  lastNameAr             String?
  status                 UserStatus @default(INVITED)
  // Local-login credential (Argon2/bcrypt hash). Null for Firebase-only accounts.
  passwordHash           String?
  passwordUpdatedAt      DateTime?  @db.Timestamptz(6)
  mustChangePassword     Boolean    @default(true)
  // Temporary-password reset lifecycle. `passwordResetIssuedAt`/`passwordResetExpiresAt` are set
  // when a temporary password is generated (Forgot Password); the temp password is only valid
  // while `mustChangePassword` is true and now < `passwordResetExpiresAt` (24h window).
  passwordResetIssuedAt  DateTime?  @db.Timestamptz(6)
  passwordResetExpiresAt DateTime?  @db.Timestamptz(6)
  // Set on every successful self-service password change (distinct from admin-set passwordUpdatedAt).
  lastPasswordChangeAt   DateTime?  @db.Timestamptz(6)
  lastLoginAt            DateTime?  @db.Timestamptz(6)
  createdAt              DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?  @db.Timestamptz(6)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles              UserRole[]
  refreshTokens          RefreshToken[]
  passwordResets         PasswordResetToken[]
  passwordResetAudits    PasswordResetAudit[]
  studentProfile         Student?
  parentProfile          Parent?
  teacherProfile         Teacher?
  employeeProfile        Employee?
  studentAttendanceMarks StudentAttendance[]     @relation("StudentAttendanceMarkedBy")
  teacherAttendanceMarks TeacherAttendance[]     @relation("TeacherAttendanceMarkedBy")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  deviceTokens           DeviceToken[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  leaveRequestsMade      LeaveRequest[]          @relation("LeaveRequestedBy")
  leaveRequestsReviewed  LeaveRequest[]          @relation("LeaveReviewedBy")
  ptmSlotsCreated        PtmSlot[]               @relation("PtmSlotCreatedBy")
  ptmBookingsMade        PtmBooking[]            @relation("PtmBookedBy")
  documentsUploaded      Document[]              @relation("DocumentUploadedBy")
  resourcesUploaded      Resource[]              @relation("ResourceUploadedBy")
  achievementsAwarded    StudentAchievement[]    @relation("AchievementAwardedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, nationalId])
  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([tenantId, status])
}

// Roles are tenant-scoped for the School plane; Platform-plane system roles use a
// null tenantId. Uniqueness is enforced per (tenantId, key).
model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  // System roles use a @munaxa/domain RoleKey (e.g. "Teacher"); custom per-tenant roles use a
  // generated slug (e.g. "custom-front-desk"). Stored as text so tenants can define their own.
  key       String
  scope     RoleScope
  isSystem  Boolean   @default(true)
  nameEn    String?
  nameAr    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Global permission catalog (not tenant-scoped). Seeded from @munaxa/domain.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. "attendance:create"
  category    String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@index([roleId])
}

// ----------------------------------------------------------------------------
// Auth: rotating refresh tokens (hashed) with reuse detection
// ----------------------------------------------------------------------------

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  // SHA-256 of the opaque refresh token; the raw token is never stored.
  tokenHash         String    @unique
  // Token family for rotation/reuse detection. Reuse of a rotated token revokes the family.
  familyId          String    @db.Uuid
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  // Set when this token was rotated; pointing at its successor.
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
}

// Dedicated, append-only audit trail for the temporary-password / forgot-password workflow.
// Kept separate from the generic AuditLog so password-reset activity (incl. failed/anonymous
// attempts) has a focused, queryable history. `email` is captured as-supplied so reset requests
// for non-existent or already-deleted accounts are still recorded for abuse analysis.
model PasswordResetAudit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid // null when the email did not resolve to a tenant user
  userId    String?  @db.Uuid // null for unknown-email / pre-resolution events
  email     String
  // e.g. "reset.request", "reset.email_sent", "reset.first_login", "reset.completed",
  // "reset.expired_attempt".
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([email, createdAt])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Audit (append-only)
// ----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid // null for platform-level events
  actorUserId String?  @db.Uuid
  actorRole   String?
  onBehalfOf  String?  @db.Uuid // set for support impersonation
  action      String // e.g. "transaction.create"
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?
  userAgent   String?
  traceId     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId])
}

// ----------------------------------------------------------------------------
// Timetable engine
// ----------------------------------------------------------------------------

// A recurring weekly class slot for a section. The REGULAR set is the master timetable;
// the RAMADAN set is used when Ramadan mode is active (see TimetableConfig). Times are
// "HH:MM" (24h) local school time.
model TimetableSlot {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  sectionId    String       @db.Uuid
  scheduleType ScheduleType @default(REGULAR)
  dayOfWeek    DayOfWeek
  periodIndex  Int
  startTime    String // "HH:MM"
  endTime      String // "HH:MM"
  subject      String
  teacherId    String?      @db.Uuid
  classroomId  String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher   Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  classroom Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sectionId, scheduleType, dayOfWeek, periodIndex])
  @@index([tenantId, sectionId])
}

// A date-specific override of the master timetable: a cancelled period, a substitute teacher,
// a replaced subject, or a whole-day holiday (periodIndex null + sectionId null => school-wide).
model ScheduleException {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @db.Uuid
  date                DateTime      @db.Date
  sectionId           String?       @db.Uuid
  periodIndex         Int?
  type                ExceptionType
  subject             String?
  teacherId           String?       @db.Uuid // replacement teacher
  substituteTeacherId String?       @db.Uuid
  classroomId         String?       @db.Uuid
  note                String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section    Section?   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher    Teacher?   @relation("ExceptionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  substitute Teacher?   @relation("ExceptionSubstitute", fields: [substituteTeacherId], references: [id], onDelete: SetNull)
  classroom  Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([tenantId, sectionId, date])
}

// Per-campus timetable settings, notably Ramadan mode and its active window.
model TimetableConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  campusId           String    @unique @db.Uuid
  ramadanModeEnabled Boolean   @default(false)
  ramadanStartDate   DateTime? @db.Date
  ramadanEndDate     DateTime? @db.Date
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Attendance
// ----------------------------------------------------------------------------

// Student attendance. periodIndex 0 = daily/homeroom; >0 = per-period. Unique per
// (student, date, period) so offline re-sync is idempotent (upsert on that key).
model StudentAttendance {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  studentId   String           @db.Uuid
  sectionId   String           @db.Uuid
  date        DateTime         @db.Date
  periodIndex Int              @default(0)
  status      AttendanceStatus
  method      AttendanceMethod @default(MANUAL)
  note        String?
  markedById  String?          @db.Uuid
  // Client-generated id from the offline queue (audit/debug; idempotency uses the unique key).
  clientRef   String?
  recordedAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("StudentAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, date, periodIndex])
  @@index([tenantId, sectionId, date])
  @@index([tenantId, studentId, date])
}

model TeacherAttendance {
  id         String                  @id @default(uuid()) @db.Uuid
  tenantId   String                  @db.Uuid
  teacherId  String                  @db.Uuid
  date       DateTime                @db.Date
  status     TeacherAttendanceStatus
  checkInAt  DateTime?               @db.Timestamptz(6)
  note       String?
  markedById String?                 @db.Uuid
  recordedAt DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime                @updatedAt @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher  Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("TeacherAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, teacherId, date])
  @@index([tenantId, date])
}

// ----------------------------------------------------------------------------
// Academics
// ----------------------------------------------------------------------------

model Homework {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  sectionId    String    @db.Uuid
  subject      String
  title        String
  description  String?
  dueDate      DateTime  @db.Date
  assignedById String?   @db.Uuid // teacher/user; plain ref (no FK relation)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section     Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attachments HomeworkAttachment[]

  @@index([tenantId, sectionId])
  @@index([tenantId, dueDate])
}

// Attachment metadata. Files live in S3 and are uploaded directly via pre-signed URLs;
// only the object key + metadata are stored here.
model HomeworkAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  homeworkId   String   @db.Uuid
  fileName     String
  fileKey      String // S3 object key
  contentType  String
  size         Int
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([tenantId, homeworkId])
}

model BehaviorLog {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  studentId    String       @db.Uuid
  type         BehaviorType
  category     String?
  title        String
  description  String?
  points       Int          @default(0)
  date         DateTime     @db.Date
  recordedById String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, date])
}

// A graded assessment. Unique per (student, subject, assessment, semester) so grade import
// is idempotent (re-importing updates the score rather than duplicating).
model GradeRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  studentId  String   @db.Uuid
  sectionId  String?  @db.Uuid
  semesterId String?  @db.Uuid
  subject    String
  assessment String // e.g. "Midterm", "Quiz 1"
  score      Decimal  @db.Decimal(6, 2)
  maxScore   Decimal  @db.Decimal(6, 2)
  weight     Decimal? @db.Decimal(5, 2)
  gradedById String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, subject, assessment, semesterId])
  @@index([tenantId, studentId])
  @@index([tenantId, sectionId])
}

// ----------------------------------------------------------------------------
// Finance (no online gateway: payments are recorded; CliQ/e-wallet via receipt upload)
// ----------------------------------------------------------------------------

model FeePlan {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  name        String
  description String?
  amount      Decimal       @db.Decimal(12, 3) // JOD
  recurrence  FeeRecurrence @default(ONE_TIME)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charges Charge[]

  @@index([tenantId])
}

model Charge {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @db.Uuid
  studentId         String       @db.Uuid
  feePlanId         String?      @db.Uuid
  description       String
  amount            Decimal      @db.Decimal(12, 3)
  dueDate           DateTime?    @db.Date
  status            ChargeStatus @default(PENDING)
  // Groups the charges that belong to one parent installment plan (one active plan per student).
  installmentPlanId String?      @db.Uuid
  createdById       String?      @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feePlan           FeePlan?            @relation(fields: [feePlanId], references: [id], onDelete: SetNull)
  transactions      Transaction[]
  einvoiceDocuments EInvoiceDocument[]
  adjustments       FeeAdjustment[]
  allocations       PaymentAllocation[]

  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, installmentPlanId])
}

// A payment toward a student's charges. CliQ/e-wallet payments are uploaded as receipts
// (receiptKey in S3) and start PENDING until a FinanceOfficer verifies them.
model Transaction {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  studentId    String            @db.Uuid
  chargeId     String?           @db.Uuid
  amount       Decimal           @db.Decimal(12, 3)
  method       PaymentMethod
  reference    String? // e.g. CliQ reference
  receiptKey   String? // S3 object key for an uploaded receipt
  status       TransactionStatus @default(PENDING)
  note         String?
  recordedById String?           @db.Uuid
  verifiedById String?           @db.Uuid
  verifiedAt   DateTime?         @db.Timestamptz(6)
  // When a parent was notified by email that this settled payment was received (null = not sent).
  parentNotifiedAt DateTime?     @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  charge            Charge?             @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  einvoiceDocuments EInvoiceDocument[]
  allocations       PaymentAllocation[]

  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

// ----------------------------------------------------------------------------
// Communication
// ----------------------------------------------------------------------------

model Announcement {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  title         String
  body          String
  audience      AnnouncementAudience @default(ALL)
  sectionId     String?              @db.Uuid
  publishedById String?              @db.Uuid
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section       Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([tenantId, createdAt])
}

// A per-user item in the in-app notification center. Fanned out from announcements/events.
// `title`/`body` hold the recipient's resolved (localized) display text; the `*En`/`*Ar` fields
// retain the rendered bilingual variants for re-localization and audit.
model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  userId         String               @db.Uuid
  type           String? // event type, e.g. "StudentAbsent"
  category       NotificationCategory @default(SYSTEM)
  priority       NotificationPriority @default(NORMAL)
  status         NotificationStatus   @default(PENDING)
  title          String
  body           String
  titleEn        String?
  titleAr        String?
  bodyEn         String?
  bodyAr         String?
  data           Json?
  mandatory      Boolean              @default(false)
  announcementId String?              @db.Uuid
  readAt         DateTime?            @db.Timestamptz(6)
  archivedAt     DateTime?            @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement?          @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  deliveries   NotificationDelivery[]
  audits       NotificationAudit[]

  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, category, createdAt])
}

// Per-user channel/category opt-in matrix. One row per (tenantId, userId); missing rows imply
// opt-in defaults. School-enforced (mandatory) notifications bypass this — see NotificationEngine.
model NotificationPreference {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  userId       String  @unique @db.Uuid
  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)

  attendancePush    Boolean @default(true)
  attendanceEmail   Boolean @default(true)
  financePush       Boolean @default(true)
  financeEmail      Boolean @default(true)
  academicPush      Boolean @default(true)
  academicEmail     Boolean @default(true)
  behaviorPush      Boolean @default(true)
  behaviorEmail     Boolean @default(true)
  announcementPush  Boolean @default(true)
  announcementEmail Boolean @default(true)
  systemPush        Boolean @default(true)
  systemEmail       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

// Versioned, bilingual templates per (eventType, channel, language). Tenant overrides the
// built-in default; renderer falls back to the default when no active row exists.
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @db.Uuid
  eventType String
  channel   NotificationChannel
  language  String // "en" | "ar"
  subject   String?
  body      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventType, channel, language])
  @@index([tenantId])
}

// One row per channel send attempt — the delivery ledger powering analytics + manual resend.
model NotificationDelivery {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  notificationId   String              @db.Uuid
  channel          NotificationChannel
  provider         String // "fcm" | "resend" | "in-app"
  status           DeliveryStatus      @default(QUEUED)
  providerResponse Json?
  attempts         Int                 @default(0)
  deliveredAt      DateTime?           @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([tenantId, notificationId])
  @@index([tenantId, status])
  @@index([tenantId, channel, createdAt])
}

// Append-only audit trail per notification (created/sent/read/resend/...).
model NotificationAudit {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  notificationId String?  @db.Uuid
  action         String
  actorId        String?  @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([tenantId, notificationId])
  @@index([tenantId, createdAt])
}

// Per-tenant sender identity + global channel kill-switches. The sender email is NEVER hardcoded;
// it defaults to notification@munaxa.com and is editable from the Admin Portal.
model NotificationSettings {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @unique @db.Uuid
  senderName   String   @default("Munaxa Notifications")
  senderEmail  String   @default("notification@munaxa.com")
  replyToEmail String   @default("support@munaxa.com")
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  deviceType String? // free-form device label (e.g. "Pixel 8", "iPad")
  active     Boolean        @default(true)
  lastSeenAt DateTime       @default(now()) @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, active])
}

// Per-tenant feature flags (e.g. the WhatsApp bridge). Disabled by default.
model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
