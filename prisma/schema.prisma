  QR
}

enum BehaviorType {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

/// Lifecycle status of a StudentFinancialAccount (§3, BR-4).
enum AccountStatus {
  ACTIVE
  CLOSED
  WRITTEN_OFF
}

/// Charge lifecycle (§3.1, ADR-007). OVERDUE is derived, never stored.
enum ChargeStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED // net driven to 0 by a granted discount/waiver
  WRITTEN_OFF // bad debt written off
  CANCELLED // voided / never owed
}

/// Cadence of a PaymentPlan schedule (IR-3). v1.0 ships MONTHLY as default.
enum PaymentPlanCadence {
  MONTHLY
  WEEKLY
  QUARTERLY
  CUSTOM
}

/// PaymentPlan lifecycle (§3.4).
enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  SUPERSEDED
  CANCELLED
}

/// Installment lifecycle (§3.3). OVERDUE is derived, never stored.
enum InstallmentStatus {
  SCHEDULED
  PARTIAL
  PAID
  WAIVED
  CANCELLED
}

enum PaymentMethod {
  CLIQ
  EWALLET
  CASH
  BANK_TRANSFER
}

/// Payment lifecycle (§3.2).
enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AnnouncementAudience {
  ALL
  PARENTS
  TEACHERS
  STUDENTS
  SECTION
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ----------------------------------------------------------------------------
// Notification platform (Push + Email only — no SMS/WhatsApp/Telegram)
// ----------------------------------------------------------------------------

// Channel-independent dispatch priority. Drives PriorityEngine channel selection + escalation.
enum NotificationPriority {
  CRITICAL // push + email immediately (emergencies, security, OTP)
  HIGH // push first; escalate to email if unread
  NORMAL // push only
  LOW // email only (digests/newsletters)
}

// Lifecycle of the in-app Notification (source of truth for the center).
enum NotificationStatus {
  PENDING // created, awaiting channel dispatch
  SENT // handed to at least one channel
  DELIVERED // a provider confirmed delivery
  READ // user opened it
  FAILED // all channels failed
  ARCHIVED // user archived it
}

// Functional grouping — mirrors the per-category preference matrix.
enum NotificationCategory {
  ATTENDANCE
  FINANCE
  ACADEMIC
  BEHAVIOR
  ANNOUNCEMENT
  SYSTEM
}

// Concrete delivery channels Munaxa supports.
enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

// Per-attempt delivery outcome recorded against a channel send.
enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  SKIPPED // suppressed by preference / kill-switch
}

// Parent portal: a leave (planned future absence) or an explanation/excuse for a past absence.
enum LeaveRequestType {
  LEAVE
  ABSENCE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Parent-Teacher Meeting slot lifecycle.
enum PtmSlotStatus {
  OPEN
  BOOKED
  CANCELLED
  COMPLETED
}

enum PtmBookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

// Document vault classification.
enum DocumentCategory {
  REPORT_CARD
  CERTIFICATE
  MEDICAL
  ID_DOCUMENT
  PERMISSION_SLIP
  OTHER
}

// Student app: learning resource kind. Munaxa is not an LMS — LINK/VIDEO deep-link out
// (Google Classroom / MS Teams), FILE/DOCUMENT are stored in S3 via the StorageService.
enum ResourceType {
  LINK
  FILE
  VIDEO
  DOCUMENT
}

// Tenant database promotion (pool → dedicated/silo) wizard state.
enum TenantDbStatus {
  REQUESTED
  PROVISIONED
  MIGRATED
  DATA_COPIED
  VERIFIED
  ACTIVE
  FAILED
  ABORTED
}

// Gamification: how an achievement is earned. STREAK/TOTAL are auto-awarded from attendance;
// ACADEMIC/GENERAL are awarded manually by staff.
enum AchievementCategory {
  ATTENDANCE_STREAK
  ATTENDANCE_TOTAL
  ACADEMIC
  GENERAL
}

// Advanced modules (Phase 14) — all gated by per-tenant feature flags, disabled by default.
enum BookLoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum InventoryTxnType {
  IN
  OUT
  ADJUST
}

enum ClinicOutcome {
  RESOLVED
  SENT_HOME
  REFERRED
  HOSPITALIZED
}

enum RoleKey {
  // Platform plane
  PlatformOwner
  PlatformAdmin
  SupportAgent
  // School plane
  SchoolAdmin
  Principal
  VicePrincipal
  FinanceOfficer
  Accountant
  Teacher
  Secretary
  Receptionist
  Registrar
  Counselor
  HR
  Nurse
  Librarian
  StoreKeeper
  FleetAdmin
  BusSupervisor
  Parent
  Student
}

// School type for the Organization identity profile (Settings → Organization → General).
enum OrganizationSchoolType {
  PRIVATE
  INTERNATIONAL
  NATIONAL
  IB
  BRITISH
  AMERICAN
  OTHER
}

// ----------------------------------------------------------------------------
// Tenancy
// ----------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  type      TenantType   @default(SCHOOL)
  name      String
  slug      String       @unique
  status    TenantStatus @default(PROVISIONING)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)

  schools                  School[]
  campuses                 Campus[]
  academicYears            AcademicYear[]
  semesters                Semester[]
  grades                   Grade[]
  classrooms               Classroom[]
  sections                 Section[]
  users                    User[]
  roles                    Role[]
  userRoles                UserRole[]
  refreshTokens            RefreshToken[]
  passwordResets           PasswordResetToken[]
  passwordResetAudits      PasswordResetAudit[]
  students                 Student[]
  parents                  Parent[]
  teachers                 Teacher[]
  employees                Employee[]
  parentStudents           ParentStudent[]
  teacherSections          TeacherSection[]
  timetableSlots           TimetableSlot[]
  scheduleExceptions       ScheduleException[]
  timetableConfigs         TimetableConfig[]
  studentAttendance        StudentAttendance[]
  teacherAttendance        TeacherAttendance[]
  homework                 Homework[]
  homeworkAttachments      HomeworkAttachment[]
  behaviorLogs             BehaviorLog[]
  gradeRecords             GradeRecord[]
  payers                   Payer[]
  financialAccounts        StudentFinancialAccount[]
  charges                  Charge[]
  paymentPlans             PaymentPlan[]
  installments             Installment[]
  payments                 Payment[]
  announcements            Announcement[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  notificationTemplates    NotificationTemplate[]
  notificationDeliveries   NotificationDelivery[]
  notificationAudits       NotificationAudit[]
  notificationSettings     NotificationSettings?
  organizationSettings     OrganizationSettings?
  deviceTokens             DeviceToken[]
  featureFlags             FeatureFlag[]
  auditLogs                AuditLog[]
  leaveRequests            LeaveRequest[]
  ptmSlots                 PtmSlot[]
  ptmBookings              PtmBooking[]
  documents                Document[]
  resources                Resource[]
  achievements             Achievement[]
  studentAchievements      StudentAchievement[]
  studentGamification      StudentGamification[]
  busRoutes                BusRoute[]
  buses                    Bus[]
  busStops                 BusStop[]
  busAssignments           StudentBusAssignment[]
  areas                    Area[]
  libraryBooks             LibraryBook[]
  bookLoans                BookLoan[]
  inventoryItems           InventoryItem[]
  inventoryTxns            InventoryTransaction[]
  medicalRecords           StudentMedicalRecord[]
  clinicVisits             ClinicVisit[]
  tenantDatabase           TenantDatabase?
  einvoiceSettings         EInvoiceSettings?
  einvoiceCredentials      EInvoiceCredential[]
  einvoiceCounter          EInvoiceCounter?
  paymentReceiptCounter    PaymentReceiptCounter?
  einvoiceDocuments        EInvoiceDocument[]
  einvoiceLogs             EInvoiceLog[]
  feeAdjustments           FeeAdjustment[]
  paymentAllocations       PaymentAllocation[]
  credits                  Credit[]
  refunds                  Refund[]
  refundConsumptions       RefundConsumption[]
  billingProfiles          StudentBillingProfile[]
  collectionsCases         CollectionsCase[]
  promiseToPays            PromiseToPay[]
  dunningEvents            DunningEvent[]
  presenceEvents           StudentPresenceEvent[]
  busAttendanceEvents      BusAttendanceEvent[]
  attendanceSourceConfig   AttendanceSourceConfig?
  studentCards             StudentCard[]
  studentVaccines          StudentVaccine[]
  gradeFeeSchedules        GradeFeeSchedule[]
  transportFares           TransportFare[]
  discountRules            DiscountRule[]
  billingPolicy            BillingPolicy?
  feeItems                 FeeItem[]
  gradeFeeItems            GradeFeeItem[]
  enrollmentQuotes         EnrollmentQuote[]
  enrollmentQuoteItems     EnrollmentQuoteItem[]
  enrollments              Enrollment[]
  feeModifications         FeeModification[]
  feeModificationApprovals FeeModificationApproval[]
  financialArrangements    FinancialArrangement[]
  registrationCommitments  RegistrationCommitment[]
  generatedDocuments       GeneratedDocument[]
  registrationAgreements   RegistrationAgreement[]
  documentSequences        DocumentSequence[]
  documentAccessLogs       DocumentAccessLog[]
  documentEmailLogs        DocumentEmailLog[]

  @@index([status])
}

// ----------------------------------------------------------------------------
// School structure
// ----------------------------------------------------------------------------

model School {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  nameEn        String
  nameAr        String
  moeSchoolCode String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campuses Campus[]

  @@unique([tenantId, moeSchoolCode])
  @@index([tenantId])
}

model Campus {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  schoolId  String    @db.Uuid
  nameEn    String
  nameAr    String
  address   String?
  phone     String?
  isMain    Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYears   AcademicYear[]
  grades          Grade[]
  classrooms      Classroom[]
  timetableConfig TimetableConfig?

  @@index([tenantId])
  @@index([tenantId, schoolId])
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  campusId  String   @db.Uuid
  name      String // e.g. "2025/2026"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus           Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  semesters        Semester[]
  feeSchedules     GradeFeeSchedule[]
  transportFares   TransportFare[]
  gradeFeeItems    GradeFeeItem[]
  charges          Charge[]
  enrollmentQuotes EnrollmentQuote[]
  enrollments      Enrollment[]
  generatedDocuments     GeneratedDocument[]
  registrationAgreements RegistrationAgreement[]
  busRoutes        BusRoute[]
  serviceAreas     Area[]

  @@unique([tenantId, campusId, name])
  @@index([tenantId, campusId])
}

model Semester {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  academicYearId String   @db.Uuid
  name           String
  sequence       Int
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeRecords GradeRecord[]

  @@unique([tenantId, academicYearId, sequence])
  @@index([tenantId, academicYearId])
}

model Grade {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  campusId  String   @db.Uuid
  nameEn    String
  nameAr    String
  level     Int // ordinal, e.g. KG=0, G1=1 ...
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus           Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sections         Section[]
  resources        Resource[]
  feeSchedules     GradeFeeSchedule[]
  gradeFeeItems    GradeFeeItem[]
  charges          Charge[]
  enrollmentQuotes EnrollmentQuote[]
  enrollments      Enrollment[]

  @@unique([tenantId, campusId, level])
  @@index([tenantId, campusId])
}

model Classroom {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  campusId  String   @db.Uuid
  name      String
  capacity  Int?
  building  String?
  floor     String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus             Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sections           Section[]
  timetableSlots     TimetableSlot[]
  scheduleExceptions ScheduleException[]

  @@unique([tenantId, campusId, name])
  @@index([tenantId, campusId])
}

model Section {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  gradeId     String   @db.Uuid
  classroomId String?  @db.Uuid
  name        String // e.g. "A", "B"
  capacity    Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grade              Grade               @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  classroom          Classroom?          @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  students           Student[]
  teacherSections    TeacherSection[]
  timetableSlots     TimetableSlot[]
  scheduleExceptions ScheduleException[]
  attendance         StudentAttendance[]
  homework           Homework[]
  gradeRecords       GradeRecord[]
  announcements      Announcement[]
  ptmSlots           PtmSlot[]
  resources          Resource[]

  @@unique([tenantId, gradeId, name])
  @@index([tenantId, gradeId])
  @@index([tenantId, classroomId])
}

// ----------------------------------------------------------------------------
// People management
// ----------------------------------------------------------------------------

model Student {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  userId           String?       @unique @db.Uuid
  moeStudentNumber String? // Ministry of Education student number
  nationalId       String? // Jordanian National ID (Raqam Watani)
  firstNameEn      String
  lastNameEn       String
  firstNameAr      String
  lastNameAr       String
  // Full Arab/MoE name parts (given · father · grandfather · family). Optional/back-compat.
  fatherNameEn     String?
  fatherNameAr     String?
  thirdNameEn      String?
  thirdNameAr      String?
  dateOfBirth      DateTime?     @db.Date
  gender           Gender?
  sectionId        String?       @db.Uuid
  qrCode           String        @unique
  status           StudentStatus @default(ACTIVE)
  // Transportation demand, set during registration (additive — Fleet remains the
  // operational source of truth via StudentBusAssignment).
  areaId             String?     @db.Uuid // home area (geographic), drives Area Planning
  transportRequested Boolean     @default(false) // parent requested transport → Unassigned queue
  enrollmentDate   DateTime      @default(now()) @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?     @db.Timestamptz(6)

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  section               Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  area                  Area?                  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  parentLinks           ParentStudent[]
  attendance            StudentAttendance[]
  behaviorLogs          BehaviorLog[]
  gradeRecords          GradeRecord[]
  financialAccount      StudentFinancialAccount?
  charges               Charge[]
  payments              Payment[]
  leaveRequests         LeaveRequest[]
  ptmBookings           PtmBooking[]
  documents             Document[]
  achievements          StudentAchievement[]
  gamification          StudentGamification?
  busAssignments        StudentBusAssignment[]
  bookLoans             BookLoan[]
  medicalRecord         StudentMedicalRecord?
  clinicVisits          ClinicVisit[]
  einvoiceDocuments     EInvoiceDocument[]
  adjustments           FeeAdjustment[]
  refunds               Refund[]
  billingProfile        StudentBillingProfile?
  presenceEvents        StudentPresenceEvent[]
  busAttendanceEvents   BusAttendanceEvent[]
  cards                 StudentCard[]
  vaccines              StudentVaccine[]
  enrollments           Enrollment[]
  enrollmentQuotes      EnrollmentQuote[]
  financialArrangements FinancialArrangement[]
  generatedDocuments    GeneratedDocument[]
  registrationAgreements RegistrationAgreement[]

  @@unique([tenantId, moeStudentNumber])
  @@unique([tenantId, nationalId])
  @@index([tenantId])
  @@index([tenantId, sectionId])
  @@index([tenantId, status])
  @@index([tenantId, areaId])
  @@index([tenantId, transportRequested])
}

model Parent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String?   @unique @db.Uuid
  firstNameEn String
  lastNameEn  String
  firstNameAr String
  lastNameAr  String
  phone       String?
  phoneAlt    String?
  email       String?
  nationalId  String?
  occupation  String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentLinks           ParentStudent[]
  payers                 Payer[]
  generatedDocuments     GeneratedDocument[]
  registrationAgreements RegistrationAgreement[]

  // Uniqueness is enforced by PARTIAL unique indexes (WHERE "deletedAt" IS NULL) created in
  // migration 20260622160000_parent_unique_partial — NOT by Prisma @@unique — so that a
  // soft-deleted parent does not reserve a mobile/national-id and the same person can be
  // re-added later. Do not add @@unique here (it would create plain indexes and reintroduce
  // the "record already exists" bug against deleted rows).
  @@index([tenantId])
}

model Teacher {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  userId         String?          @unique @db.Uuid
  employeeNumber String?
  firstNameEn    String
  lastNameEn     String
  firstNameAr    String
  lastNameAr     String
  specialization String?
  status         EmploymentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?        @db.Timestamptz(6)

  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  sections               TeacherSection[]
  timetableSlots         TimetableSlot[]
  exceptionReplacements  ScheduleException[] @relation("ExceptionTeacher")
  exceptionSubstitutions ScheduleException[] @relation("ExceptionSubstitute")
  attendance             TeacherAttendance[]
  ptmSlots               PtmSlot[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
}

model Employee {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  userId      String?          @unique @db.Uuid
  firstNameEn String
  lastNameEn  String
  firstNameAr String
  lastNameAr  String
  jobTitle    String
  department  String?
  status      EmploymentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?        @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model ParentStudent {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  parentId  String         @db.Uuid
  studentId String         @db.Uuid
  relation  ParentRelation
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

model TeacherSection {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  teacherId String   @db.Uuid
  sectionId String   @db.Uuid
  subject   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teacherId])
  @@index([sectionId])
}

// ----------------------------------------------------------------------------
// Identity & Access (IAM)
// ----------------------------------------------------------------------------

model User {
  id                     String     @id @default(uuid()) @db.Uuid
  tenantId               String     @db.Uuid
  firebaseUid            String?    @unique
  email                  String
  // Optional login handle (e.g. for students/parents without email). Unique per tenant.
  username               String?
  phone                  String?
  nationalId             String? // Jordanian National ID (Raqam Watani)
  firstNameEn            String?
  lastNameEn             String?
  firstNameAr            String?
  lastNameAr             String?
  status                 UserStatus @default(INVITED)
  // Local-login credential (Argon2/bcrypt hash). Null for Firebase-only accounts.
  passwordHash           String?
  passwordUpdatedAt      DateTime?  @db.Timestamptz(6)
  mustChangePassword     Boolean    @default(true)
  // Temporary-password reset lifecycle. `passwordResetIssuedAt`/`passwordResetExpiresAt` are set
  // when a temporary password is generated (Forgot Password); the temp password is only valid
  // while `mustChangePassword` is true and now < `passwordResetExpiresAt` (24h window).
  passwordResetIssuedAt  DateTime?  @db.Timestamptz(6)
  passwordResetExpiresAt DateTime?  @db.Timestamptz(6)
  // Set on every successful self-service password change (distinct from admin-set passwordUpdatedAt).
  lastPasswordChangeAt   DateTime?  @db.Timestamptz(6)
  lastLoginAt            DateTime?  @db.Timestamptz(6)
  createdAt              DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?  @db.Timestamptz(6)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles              UserRole[]
  refreshTokens          RefreshToken[]
  passwordResets         PasswordResetToken[]
  passwordResetAudits    PasswordResetAudit[]
  studentProfile         Student?
  parentProfile          Parent?
  teacherProfile         Teacher?
  employeeProfile        Employee?
  studentAttendanceMarks StudentAttendance[]     @relation("StudentAttendanceMarkedBy")
  teacherAttendanceMarks TeacherAttendance[]     @relation("TeacherAttendanceMarkedBy")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  deviceTokens           DeviceToken[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  leaveRequestsMade      LeaveRequest[]          @relation("LeaveRequestedBy")
  leaveRequestsReviewed  LeaveRequest[]          @relation("LeaveReviewedBy")
  ptmSlotsCreated        PtmSlot[]               @relation("PtmSlotCreatedBy")
  ptmBookingsMade        PtmBooking[]            @relation("PtmBookedBy")
  documentsUploaded      Document[]              @relation("DocumentUploadedBy")
  resourcesUploaded      Resource[]              @relation("ResourceUploadedBy")
  achievementsAwarded    StudentAchievement[]    @relation("AchievementAwardedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, nationalId])
  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([tenantId, status])
}

// Roles are tenant-scoped for the School plane; Platform-plane system roles use a
// null tenantId. Uniqueness is enforced per (tenantId, key).
model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  // System roles use a @munaxa/domain RoleKey (e.g. "Teacher"); custom per-tenant roles use a
  // generated slug (e.g. "custom-front-desk"). Stored as text so tenants can define their own.
  key       String
  scope     RoleScope
  isSystem  Boolean   @default(true)
  nameEn    String?
  nameAr    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Global permission catalog (not tenant-scoped). Seeded from @munaxa/domain.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. "attendance:create"
  category    String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@index([roleId])
}

// ----------------------------------------------------------------------------
// Auth: rotating refresh tokens (hashed) with reuse detection
// ----------------------------------------------------------------------------

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  // SHA-256 of the opaque refresh token; the raw token is never stored.
  tokenHash         String    @unique
  // Token family for rotation/reuse detection. Reuse of a rotated token revokes the family.
  familyId          String    @db.Uuid
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  // Set when this token was rotated; pointing at its successor.
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
}

// Dedicated, append-only audit trail for the temporary-password / forgot-password workflow.
// Kept separate from the generic AuditLog so password-reset activity (incl. failed/anonymous
// attempts) has a focused, queryable history. `email` is captured as-supplied so reset requests
// for non-existent or already-deleted accounts are still recorded for abuse analysis.
model PasswordResetAudit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid // null when the email did not resolve to a tenant user
  userId    String?  @db.Uuid // null for unknown-email / pre-resolution events
  email     String
  // e.g. "reset.request", "reset.email_sent", "reset.first_login", "reset.completed",
  // "reset.expired_attempt".
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([email, createdAt])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Audit (append-only)
// ----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid // null for platform-level events
  actorUserId String?  @db.Uuid
  actorRole   String?
  onBehalfOf  String?  @db.Uuid // set for support impersonation
  action      String // e.g. "transaction.create"
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?
  userAgent   String?
  traceId     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId])
}

// ----------------------------------------------------------------------------
// Timetable engine
// ----------------------------------------------------------------------------

// A recurring weekly class slot for a section. The REGULAR set is the master timetable;
// the RAMADAN set is used when Ramadan mode is active (see TimetableConfig). Times are
// "HH:MM" (24h) local school time.
model TimetableSlot {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  sectionId    String       @db.Uuid
  scheduleType ScheduleType @default(REGULAR)
  dayOfWeek    DayOfWeek
  periodIndex  Int
  startTime    String // "HH:MM"
  endTime      String // "HH:MM"
  subject      String
  teacherId    String?      @db.Uuid
  classroomId  String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher   Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  classroom Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sectionId, scheduleType, dayOfWeek, periodIndex])
  @@index([tenantId, sectionId])
}

// A date-specific override of the master timetable: a cancelled period, a substitute teacher,
// a replaced subject, or a whole-day holiday (periodIndex null + sectionId null => school-wide).
model ScheduleException {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @db.Uuid
  date                DateTime      @db.Date
  sectionId           String?       @db.Uuid
  periodIndex         Int?
  type                ExceptionType
  subject             String?
  teacherId           String?       @db.Uuid // replacement teacher
  substituteTeacherId String?       @db.Uuid
  classroomId         String?       @db.Uuid
  note                String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section    Section?   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher    Teacher?   @relation("ExceptionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  substitute Teacher?   @relation("ExceptionSubstitute", fields: [substituteTeacherId], references: [id], onDelete: SetNull)
  classroom  Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([tenantId, sectionId, date])
}

// Per-campus timetable settings, notably Ramadan mode and its active window.
model TimetableConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  campusId           String    @unique @db.Uuid
  ramadanModeEnabled Boolean   @default(false)
  ramadanStartDate   DateTime? @db.Date
  ramadanEndDate     DateTime? @db.Date
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Attendance
// ----------------------------------------------------------------------------

// Student attendance. periodIndex 0 = daily/homeroom; >0 = per-period. Unique per
// (student, date, period) so offline re-sync is idempotent (upsert on that key).
model StudentAttendance {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  studentId   String           @db.Uuid
  sectionId   String           @db.Uuid
  date        DateTime         @db.Date
  periodIndex Int              @default(0)
  status      AttendanceStatus
  method      AttendanceMethod @default(MANUAL)
  note        String?
  markedById  String?          @db.Uuid
  // Client-generated id from the offline queue (audit/debug; idempotency uses the unique key).
  clientRef   String?
  recordedAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("StudentAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, date, periodIndex])
  @@index([tenantId, sectionId, date])
  @@index([tenantId, studentId, date])
}

model TeacherAttendance {
  id         String                  @id @default(uuid()) @db.Uuid
  tenantId   String                  @db.Uuid
  teacherId  String                  @db.Uuid
  date       DateTime                @db.Date
  status     TeacherAttendanceStatus
  checkInAt  DateTime?               @db.Timestamptz(6)
  note       String?
  markedById String?                 @db.Uuid
  recordedAt DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime                @updatedAt @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher  Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("TeacherAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, teacherId, date])
  @@index([tenantId, date])
}

// ----------------------------------------------------------------------------
// Academics
// ----------------------------------------------------------------------------

model Homework {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  sectionId    String    @db.Uuid
  subject      String
  title        String
  description  String?
  dueDate      DateTime  @db.Date
  assignedById String?   @db.Uuid // teacher/user; plain ref (no FK relation)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section     Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attachments HomeworkAttachment[]

  @@index([tenantId, sectionId])
  @@index([tenantId, dueDate])
}

// Attachment metadata. Files live in S3 and are uploaded directly via pre-signed URLs;
// only the object key + metadata are stored here.
model HomeworkAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  homeworkId   String   @db.Uuid
  fileName     String
  fileKey      String // S3 object key
  contentType  String
  size         Int
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([tenantId, homeworkId])
}

model BehaviorLog {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  studentId    String       @db.Uuid
  type         BehaviorType
  category     String?
  title        String
  description  String?
  points       Int          @default(0)
  date         DateTime     @db.Date
  recordedById String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, date])
}

// A graded assessment. Unique per (student, subject, assessment, semester) so grade import
// is idempotent (re-importing updates the score rather than duplicating).
model GradeRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  studentId  String   @db.Uuid
  sectionId  String?  @db.Uuid
  semesterId String?  @db.Uuid
  subject    String
  assessment String // e.g. "Midterm", "Quiz 1"
  score      Decimal  @db.Decimal(6, 2)
  maxScore   Decimal  @db.Decimal(6, 2)
  weight     Decimal? @db.Decimal(5, 2)
  gradedById String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, subject, assessment, semesterId])
  @@index([tenantId, studentId])
  @@index([tenantId, sectionId])
}

// ----------------------------------------------------------------------------
// Finance (no online gateway: payments are recorded; CliQ/e-wallet via receipt upload)
// ----------------------------------------------------------------------------

// ============================================================================
// Accounts Receivable (AR) core — Finance Domain Specification v1.0.
//   StudentFinancialAccount → Charge → PaymentPlan → Installment
//                          ↳ Payment → PaymentAllocation (→ Installment)
//                          ↳ Credit → RefundConsumption ← Refund
//   A Charge is the financial OBLIGATION; a PaymentPlan is HOW it may be paid;
//   an Installment is WHEN a portion is due; a Payment is money RECEIVED; an
//   Allocation applies money to an Installment. These concepts never merge.
// ============================================================================

/// A billing party (guardian/company) that may be responsible for one or more
/// student accounts and may hold payments/credits. Receivables stay owned by the
/// student account (BR-3, ADR-003).
model Payer {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  parentId    String?  @db.Uuid // link to the guardian person when the payer is a parent
  nameEn      String
  nameAr      String
  phone       String?
  email       String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Parent?                   @relation(fields: [parentId], references: [id], onDelete: SetNull)
  accounts StudentFinancialAccount[]
  payments Payment[]
  credits  Credit[]
  refunds  Refund[]

  @@index([tenantId])
  @@index([tenantId, parentId])
}

/// The AR ledger owner for one student: currency, status, optional payer. Every
/// financial row for the student hangs off this account (BR-1, BR-2, BR-4).
model StudentFinancialAccount {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  studentId String        @unique @db.Uuid
  payerId   String?       @db.Uuid
  currency  String        @default("JOD")
  status    AccountStatus @default(ACTIVE)
  openedAt  DateTime      @default(now()) @db.Timestamptz(6)
  closedAt  DateTime?     @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payer           Payer?            @relation(fields: [payerId], references: [id], onDelete: SetNull)
  charges         Charge[]
  payments        Payment[]
  adjustments     FeeAdjustment[]
  credits         Credit[]
  refunds         Refund[]
  collectionsCase CollectionsCase?

  @@index([tenantId])
  @@index([tenantId, payerId])
}

/// A single financial OBLIGATION owed by one account (e.g. "Annual Tuition 2026/27").
/// Never split into sub-charges; paid via 0..1 active PaymentPlan (BR-5..10, ADR-001).
model Charge {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  accountId      String       @db.Uuid
  studentId      String       @db.Uuid // denormalised for RLS-friendly filters + reporting
  // Reporting dimensions (RR-2) — nullable when not derivable.
  academicYearId String?      @db.Uuid
  gradeId        String?      @db.Uuid
  campusId       String?      @db.Uuid
  feeItemId      String?      @db.Uuid
  enrollmentId   String?      @db.Uuid
  description    String
  amount         Decimal      @db.Decimal(12, 3)
  currency       String       @default("JOD")
  dueDate        DateTime?    @db.Date // pay-in-full due when there is no plan
  status         ChargeStatus @default(PENDING)
  createdById    String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account           StudentFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  student           Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear?           @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  grade             Grade?                  @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  feeItem           FeeItem?                @relation(fields: [feeItemId], references: [id], onDelete: SetNull)
  plans             PaymentPlan[] // one ACTIVE at a time (partial unique index); history retained
  installments      Installment[]
  adjustments       FeeAdjustment[]
  einvoiceDocuments EInvoiceDocument[]

  @@index([tenantId, accountId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, academicYearId])
  @@index([tenantId, feeItemId])
}

/// HOW a charge may be paid over time: cadence, count, terms, status. 0..1 active per
/// charge; superseding regenerates the schedule for the remaining balance (BR-11..13, ADR-001).
model PaymentPlan {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  chargeId     String             @db.Uuid
  cadence      PaymentPlanCadence @default(MONTHLY)
  installments Int
  firstDueDate DateTime           @db.Date
  balloonFinal Boolean            @default(false)
  status       PaymentPlanStatus  @default(ACTIVE)
  createdById  String?            @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge          Charge        @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  installmentRows Installment[]

  // At most one ACTIVE plan per charge is enforced by a partial unique index (see migration).
  @@index([tenantId, chargeId])
  @@index([tenantId, status])
}

/// WHEN a scheduled portion of a charge's net is expected. A schedule line — never a
/// charge, never invoiced. Σ installment.amount == charge.net (BR-9, BR-14, IR-2).
model Installment {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  chargeId  String            @db.Uuid // denormalised for direct account/aging scans
  planId    String?           @db.Uuid // null = the implicit single installment of a plan-less charge
  seq       Int
  dueDate   DateTime?         @db.Date
  amount    Decimal           @db.Decimal(12, 3)
  status    InstallmentStatus @default(SCHEDULED)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge      Charge              @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  plan        PaymentPlan?        @relation(fields: [planId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@index([tenantId, chargeId])
  @@index([tenantId, planId])
  @@index([tenantId, dueDate])
  @@index([tenantId, status])
}

/// Actual money RECEIVED. CliQ/e-wallet payments are uploaded as receipts (receiptKey in S3)
/// and start PENDING until a FinanceOfficer verifies them; a gapless receiptNo is assigned
/// once, at verify. Allocations apply the money to installments (BR-17..25).
model Payment {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  accountId        String              @db.Uuid
  studentId        String              @db.Uuid
  payerId          String?             @db.Uuid
  amount           Decimal             @db.Decimal(12, 3)
  currency         String              @default("JOD")
  method           PaymentMethod
  reference        String? // e.g. CliQ reference
  receiptKey       String? // S3 object key for an uploaded receipt
  receiptNo        Int? // gapless per-tenant official receipt number (assigned at verify)
  status           PaymentStatus       @default(PENDING)
  note             String?
  recordedById     String?             @db.Uuid
  verifiedById     String?             @db.Uuid
  verifiedAt       DateTime?           @db.Timestamptz(6)
  parentNotifiedAt DateTime?           @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(6)

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account           StudentFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  student           Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payer             Payer?                  @relation(fields: [payerId], references: [id], onDelete: SetNull)
  allocations       PaymentAllocation[]
  credits           Credit[]
  einvoiceDocuments EInvoiceDocument[]

  @@unique([tenantId, receiptNo])
  @@index([tenantId, accountId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

/// Row-locked, per-tenant counter that hands out gapless receipt numbers for verified payments
/// (same pattern as EInvoiceCounter / the JoFotara ICV). Created lazily on first use (BR-18, MT-3).
model PaymentReceiptCounter {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @unique @db.Uuid
  nextReceiptNo Int    @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// Communication
// ----------------------------------------------------------------------------

model Announcement {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  title         String
  body          String
  audience      AnnouncementAudience @default(ALL)
  sectionId     String?              @db.Uuid
  publishedById String?              @db.Uuid
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section       Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([tenantId, createdAt])
}

// A per-user item in the in-app notification center. Fanned out from announcements/events.
// `title`/`body` hold the recipient's resolved (localized) display text; the `*En`/`*Ar` fields
// retain the rendered bilingual variants for re-localization and audit.
model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  userId         String               @db.Uuid
  type           String? // event type, e.g. "StudentAbsent"
  category       NotificationCategory @default(SYSTEM)
  priority       NotificationPriority @default(NORMAL)
  status         NotificationStatus   @default(PENDING)
  title          String
  body           String
  titleEn        String?
  titleAr        String?
  bodyEn         String?
  bodyAr         String?
  data           Json?
  mandatory      Boolean              @default(false)
  announcementId String?              @db.Uuid
  readAt         DateTime?            @db.Timestamptz(6)
  archivedAt     DateTime?            @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement?          @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  deliveries   NotificationDelivery[]
  audits       NotificationAudit[]

  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, category, createdAt])
}

// Per-user channel/category opt-in matrix. One row per (tenantId, userId); missing rows imply
// opt-in defaults. School-enforced (mandatory) notifications bypass this — see NotificationEngine.
model NotificationPreference {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  userId       String  @unique @db.Uuid
  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)

  attendancePush    Boolean @default(true)
  attendanceEmail   Boolean @default(true)
  financePush       Boolean @default(true)
  financeEmail      Boolean @default(true)
  academicPush      Boolean @default(true)
  academicEmail     Boolean @default(true)
  behaviorPush      Boolean @default(true)
  behaviorEmail     Boolean @default(true)
  announcementPush  Boolean @default(true)
  announcementEmail Boolean @default(true)
  systemPush        Boolean @default(true)
  systemEmail       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

// Versioned, bilingual templates per (eventType, channel, language). Tenant overrides the
// built-in default; renderer falls back to the default when no active row exists.
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @db.Uuid
  eventType String
  channel   NotificationChannel
  language  String // "en" | "ar"
  subject   String?
  body      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventType, channel, language])
  @@index([tenantId])
}

// One row per channel send attempt — the delivery ledger powering analytics + manual resend.
model NotificationDelivery {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  notificationId   String              @db.Uuid
  channel          NotificationChannel
  provider         String // "fcm" | "resend" | "in-app"
  status           DeliveryStatus      @default(QUEUED)
  providerResponse Json?
  attempts         Int                 @default(0)
  deliveredAt      DateTime?           @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([tenantId, notificationId])
  @@index([tenantId, status])
  @@index([tenantId, channel, createdAt])
}

// Append-only audit trail per notification (created/sent/read/resend/...).
model NotificationAudit {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  notificationId String?  @db.Uuid
  action         String
  actorId        String?  @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([tenantId, notificationId])
  @@index([tenantId, createdAt])
}

// Per-tenant sender identity + global channel kill-switches. The sender email is NEVER hardcoded;
// it defaults to notification@munaxa.com and is editable from the Admin Portal.
model NotificationSettings {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @unique @db.Uuid
  senderName   String   @default("Munaxa Notifications")
  senderEmail  String   @default("notification@munaxa.com")
  replyToEmail String   @default("support@munaxa.com")
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Single source of truth for school identity, branding, document generation, communication,
/// compliance, social presence, and advanced document defaults (Settings → Organization).
/// One row per tenant. Every optional branding/document feature has its own enable toggle; when a
/// toggle is off the corresponding asset/section is omitted from generated documents and the UI.
/// Asset columns store S3 object keys (never the binary). Structured/optional sub-configs are kept
/// in JSON columns (forward-compatible, mirrors EInvoiceSettings.templateConfig).
model OrganizationSettings {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid

  // ── General / identity ──
  nameEn           String?
  nameAr           String?
  legalName        String?
  shortName        String?
  schoolCode       String?
  ministryNumber   String?
  schoolType       OrganizationSchoolType @default(PRIVATE)
  motto            String?
  mission          String?
  vision           String?
  establishedYear  Int?
  description       String?
  timezone         String                 @default("Asia/Amman")
  defaultLanguage  String                 @default("en")
  academicCalendar String?

  // ── Contact ──
  phone            String?
  mobile           String?
  whatsapp         String?
  email            String?
  website          String?
  country          String?
  city             String?
  district         String?
  street           String?
  building         String?
  postalCode       String?
  googleMapsUrl    String?
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  emergencyContact String?
  officeHours      String?

  // ── Branding feature toggles (every feature independently enabled) ──
  logoEnabled      Boolean @default(false)
  darkLogoEnabled  Boolean @default(false)
  smallLogoEnabled Boolean @default(false)
  watermarkEnabled Boolean @default(false)
  stampEnabled     Boolean @default(false)
  signatureEnabled Boolean @default(false)

  // ── Branding assets (S3 object keys) ──
  logoKey      String?
  darkLogoKey  String?
  smallLogoKey String?
  stampKey     String?
  signatureKey String?
  bannerKey    String?

  // ── Branding structured config ──
  logoVisibility    Json? // { reports, certificates, studentCards, parentPortal, mobileApp, login }
  watermark         Json? // { source: LOGO|SCHOOL_NAME|CONFIDENTIAL, text, opacity, scale, rotation }
  stampPlacement    String @default("RIGHT") // LEFT | CENTER | RIGHT
  signaturePosition String @default("RIGHT") // LEFT | CENTER | RIGHT

  // ── Document settings ──
  headerEnabled Boolean @default(false)
  footerEnabled Boolean @default(false)
  qrEnabled     Boolean @default(false)
  documents     Json? // { headerHtml, headerAlign, footerHtml, footerAlign, logoPosition, paperSize, margins{top,bottom,left,right}, headerHeight, footerHeight, qrContent }

  // ── Communication identity ──
  senderName              String?
  senderEmail             String?
  replyToEmail            String?
  emailFooter             String?
  notificationDisplayName String?
  smsSender               String?
  whatsappDisplayName     String?
  pushIconKey             String?
  notificationImageKey    String?

  // ── Social & website ──
  socialEnabled Boolean @default(false)
  social        Json? // { website, facebook, instagram, linkedin, youtube, tiktok, x }

  // ── Academic identity ──
  curriculum         String?
  academicYearFormat String?
  colorTheme         String?

  // ── Compliance (optional) ──
  complianceEnabled      Boolean @default(false)
  commercialRegistration String?
  licenseNumber          String?
  ministryLicense        String?
  taxNumber              String?
  vatNumber              String?
  otherGovIds            Json? // [{ label, value }]

  // ── Advanced document defaults ──
  defaultReportLanguage      String  @default("en")
  defaultCertificateLanguage String  @default("en")
  documentNumberPrefix       String?
  defaultFont                String?
  defaultReportTheme         String?
  defaultLogoVariant         String  @default("PRIMARY") // PRIMARY | DARK | SMALL
  documentCompression        Boolean @default(true)
  pdfQuality                 Int     @default(90)
  imageQuality               Int     @default(85)
  storageOptimization        Boolean @default(true)

  // ── Audit ──
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  deviceType String? // free-form device label (e.g. "Pixel 8", "iPad")
  active     Boolean        @default(true)
  lastSeenAt DateTime       @default(now()) @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, active])
}

// Per-tenant feature flags (e.g. the WhatsApp bridge). Disabled by default.
model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Parent portal (Phase 11)
// ----------------------------------------------------------------------------

// A parent-submitted leave (planned) or absence (excuse) request for one of their children.
// Reviewed (approved/rejected) by school staff holding leave:approve.
model LeaveRequest {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  studentId     String             @db.Uuid
  requestedById String?            @db.Uuid
  type          LeaveRequestType
  status        LeaveRequestStatus @default(PENDING)
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  reason        String
  reviewedById  String?            @db.Uuid
  reviewNote    String?
  reviewedAt    DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User?   @relation("LeaveRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy  User?   @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

// A Parent-Teacher Meeting slot offered by a teacher (optionally for a specific section).
model PtmSlot {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  teacherId   String        @db.Uuid
  sectionId   String?       @db.Uuid
  startsAt    DateTime      @db.Timestamptz(6)
  endsAt      DateTime      @db.Timestamptz(6)
  location    String?
  capacity    Int           @default(1)
  status      PtmSlotStatus @default(OPEN)
  notes       String?
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher   Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section   Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("PtmSlotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bookings  PtmBooking[]

  @@index([tenantId])
  @@index([tenantId, teacherId])
  @@index([tenantId, startsAt])
}

// A parent's booking of a PTM slot for one of their children.
model PtmBooking {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  slotId     String           @db.Uuid
  studentId  String           @db.Uuid
  bookedById String?          @db.Uuid
  status     PtmBookingStatus @default(BOOKED)
  note       String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slot     PtmSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bookedBy User?   @relation("PtmBookedBy", fields: [bookedById], references: [id], onDelete: SetNull)

  @@unique([slotId, studentId])
  @@index([tenantId])
  @@index([tenantId, slotId])
  @@index([tenantId, studentId])
}

// Document vault: secure files attached to a student (report cards, certificates, medical, IDs).
// Uploaded by parents (for their children) or staff, stored in S3 via the StorageService.
model Document {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  studentId    String           @db.Uuid
  title        String
  category     DocumentCategory @default(OTHER)
  fileKey      String
  fileName     String
  contentType  String
  size         Int
  uploadedById String?          @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  deletedAt    DateTime?        @db.Timestamptz(6)

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, studentId])
}

// ----------------------------------------------------------------------------
// Student app (Phase 12): resource library + gamification
// ----------------------------------------------------------------------------

// A learning resource visible to students. Scoped to a section, a whole grade, or the whole
// school (both null). FILE/DOCUMENT live in S3; LINK/VIDEO deep-link out (not an LMS).
model Resource {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  sectionId    String?      @db.Uuid
  gradeId      String?      @db.Uuid
  subject      String?
  title        String
  description  String?
  type         ResourceType @default(LINK)
  url          String?
  fileKey      String?
  fileName     String?
  contentType  String?
  size         Int?
  uploadedById String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?    @db.Timestamptz(6)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section    Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  grade      Grade?   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("ResourceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, sectionId])
  @@index([tenantId, gradeId])
}

// A per-tenant achievement/badge definition. ATTENDANCE_* are auto-awarded when a student's
// streak/total reaches `threshold`; ACADEMIC/GENERAL are awarded manually by staff.
model Achievement {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  key         String
  nameEn      String
  nameAr      String
  description String?
  icon        String?
  category    AchievementCategory @default(GENERAL)
  points      Int                 @default(0)
  threshold   Int?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentAchievements StudentAchievement[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

// A student's earned achievement (idempotent per student+achievement).
model StudentAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  studentId     String   @db.Uuid
  achievementId String   @db.Uuid
  awardedById   String?  @db.Uuid
  note          String?
  earnedAt      DateTime @default(now()) @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  awardedBy   User?       @relation("AchievementAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)

  @@unique([studentId, achievementId])
  @@index([tenantId])
  @@index([tenantId, studentId])
}

// Per-student gamification rollup: points, level, and attendance streaks (recomputed on sync).
model StudentGamification {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  studentId     String    @unique @db.Uuid
  totalPoints   Int       @default(0)
  level         Int       @default(1)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastSyncedAt  DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Advanced modules (Phase 14) — feature-flagged, OFF by default
// ----------------------------------------------------------------------------

// --- Bus tracking -----------------------------------------------------------
/// Geographic area master data (e.g. Khalda, Dabouq). The transportation department
/// maps each area to the route that serves it (Area → Route) so registration can resolve
/// the route automatically. Fleet remains the operational source of truth (routes/
/// assignments); billing still flows through TransportFare — transportFee is an optional
/// per-area override only.
model Area {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @db.Uuid
  name                    String
  routeId                 String?   @db.Uuid // the route that serves this area (Area → Route)
  academicYearId          String?   @db.Uuid // which year this route mapping reflects (optional)
  transportFee            Decimal?  @db.Decimal(12, 3) // optional fee override; default is the route's TransportFare
  transportationAvailable Boolean   @default(true) // surfaced as a choice in registration
  active                  Boolean   @default(true)
  notes                   String?
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt               DateTime? @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route        BusRoute?     @relation(fields: [routeId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  students     Student[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([routeId])
}

model BusRoute {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  academicYearId String?   @db.Uuid // groups routes by academic year (e.g. 2026/2027)
  name           String
  description    String?
  round1Time     String? // 1st trip time, "HH:MM"
  round2Time     String? // 2nd trip time, "HH:MM"
  disabledAt     DateTime? @db.Timestamptz(6) // when set, the route is disabled (still listed, shown as disabled)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear?          @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  buses          Bus[]
  stops          BusStop[]
  assignments    StudentBusAssignment[]
  transportFares TransportFare[]
