// ============================================================================
// Munaxa — Prisma schema
// Phase 2: Core Database Design.
//
// Multi-tenant model: shared PostgreSQL, shared schema. Every business entity
// carries a non-null `tenantId`. Isolation is enforced in depth (see
// docs/architecture/03-multi-tenant-architecture.md and the RLS migration):
//   1. JWT tenant claim (Phase 3)         3. Prisma client extension (tenant scoping)
//   2. Tenant guard (Phase 3)             4. PostgreSQL Row-Level Security (this phase)
//
// Conventions:
//   - UUID primary keys (@db.Uuid), app-generated.
//   - timestamptz timestamps (createdAt/updatedAt); soft delete via deletedAt
//     on recoverable business records.
//   - Tenant-scoped uniqueness (e.g. @@unique([tenantId, ...])).
//   - Composite indexes lead with tenantId.
//   - Bilingual fields use *_En / *_Ar pairs.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: a NON-superuser, NOBYPASSRLS role so Row-Level Security
  // is enforced on the application (see the RLS migration).
  url       = env("DATABASE_URL")
  // Migrations/introspection connect as the schema owner (privileged). Falls back
  // to DATABASE_URL when unset (e.g. simple local setups).
  directUrl = env("DIRECT_DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum TenantType {
  SCHOOL
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RoleScope {
  PLATFORM
  SCHOOL
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum DayOfWeek {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum ScheduleType {
  REGULAR
  RAMADAN
}

enum ExceptionType {
  CANCELLATION
  SUBSTITUTION
  REPLACEMENT
  HOLIDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TeacherAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
}

enum AttendanceMethod {
  MANUAL
  QR
}

enum BehaviorType {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum FeeRecurrence {
  ONE_TIME
  MONTHLY
  TERM
  ANNUAL
}

enum ChargeStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED
  CANCELLED
}

enum PaymentMethod {
  CLIQ
  EWALLET
  CASH
  BANK_TRANSFER
}

enum TransactionStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AnnouncementAudience {
  ALL
  PARENTS
  TEACHERS
  STUDENTS
  SECTION
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// Parent portal: a leave (planned future absence) or an explanation/excuse for a past absence.
enum LeaveRequestType {
  LEAVE
  ABSENCE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Parent-Teacher Meeting slot lifecycle.
enum PtmSlotStatus {
  OPEN
  BOOKED
  CANCELLED
  COMPLETED
}

enum PtmBookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

// Document vault classification.
enum DocumentCategory {
  REPORT_CARD
  CERTIFICATE
  MEDICAL
  ID_DOCUMENT
  PERMISSION_SLIP
  OTHER
}

// Student app: learning resource kind. Munaxa is not an LMS — LINK/VIDEO deep-link out
// (Google Classroom / MS Teams), FILE/DOCUMENT are stored in S3 via the StorageService.
enum ResourceType {
  LINK
  FILE
  VIDEO
  DOCUMENT
}

// Gamification: how an achievement is earned. STREAK/TOTAL are auto-awarded from attendance;
// ACADEMIC/GENERAL are awarded manually by staff.
enum AchievementCategory {
  ATTENDANCE_STREAK
  ATTENDANCE_TOTAL
  ACADEMIC
  GENERAL
}

// Advanced modules (Phase 14) — all gated by per-tenant feature flags, disabled by default.
enum BookLoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum InventoryTxnType {
  IN
  OUT
  ADJUST
}

enum ClinicOutcome {
  RESOLVED
  SENT_HOME
  REFERRED
  HOSPITALIZED
}

enum RoleKey {
  // Platform plane
  PlatformOwner
  PlatformAdmin
  SupportAgent
  // School plane
  SchoolAdmin
  Principal
  VicePrincipal
  FinanceOfficer
  Teacher
  Secretary
  Parent
  Student
}

// ----------------------------------------------------------------------------
// Tenancy
// ----------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  type      TenantType   @default(SCHOOL)
  name      String
  slug      String       @unique
  status    TenantStatus @default(PROVISIONING)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)

  schools             School[]
  campuses            Campus[]
  academicYears       AcademicYear[]
  semesters           Semester[]
  grades              Grade[]
  classrooms          Classroom[]
  sections            Section[]
  users               User[]
  roles               Role[]
  userRoles           UserRole[]
  refreshTokens       RefreshToken[]
  passwordResets      PasswordResetToken[]
  students            Student[]
  parents             Parent[]
  teachers            Teacher[]
  employees           Employee[]
  parentStudents      ParentStudent[]
  teacherSections     TeacherSection[]
  timetableSlots      TimetableSlot[]
  scheduleExceptions  ScheduleException[]
  timetableConfigs    TimetableConfig[]
  studentAttendance   StudentAttendance[]
  teacherAttendance   TeacherAttendance[]
  homework            Homework[]
  homeworkAttachments HomeworkAttachment[]
  behaviorLogs        BehaviorLog[]
  gradeRecords        GradeRecord[]
  feePlans            FeePlan[]
  charges             Charge[]
  transactions        Transaction[]
  announcements       Announcement[]
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  featureFlags        FeatureFlag[]
  auditLogs           AuditLog[]
  leaveRequests       LeaveRequest[]
  ptmSlots            PtmSlot[]
  ptmBookings         PtmBooking[]
  documents           Document[]
  resources           Resource[]
  achievements        Achievement[]
  studentAchievements StudentAchievement[]
  studentGamification StudentGamification[]
  busRoutes           BusRoute[]
  buses               Bus[]
  busStops            BusStop[]
  busAssignments      StudentBusAssignment[]
  libraryBooks        LibraryBook[]
  bookLoans           BookLoan[]
  inventoryItems      InventoryItem[]
  inventoryTxns       InventoryTransaction[]
  medicalRecords      StudentMedicalRecord[]
  clinicVisits        ClinicVisit[]

  @@index([status])
}

// ----------------------------------------------------------------------------
// School structure
// ----------------------------------------------------------------------------

model School {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  nameEn        String
  nameAr        String
  moeSchoolCode String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campuses Campus[]

  @@unique([tenantId, moeSchoolCode])
  @@index([tenantId])
}

model Campus {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  schoolId  String    @db.Uuid
  nameEn    String
  nameAr    String
  address   String?
  phone     String?
  isMain    Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYears   AcademicYear[]
  grades          Grade[]
  classrooms      Classroom[]
  timetableConfig TimetableConfig?

  @@index([tenantId])
  @@index([tenantId, schoolId])
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  campusId  String   @db.Uuid
  name      String // e.g. "2025/2026"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus    Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  semesters Semester[]

  @@unique([tenantId, campusId, name])
  @@index([tenantId, campusId])
}

model Semester {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  academicYearId String   @db.Uuid
  name           String
  sequence       Int
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeRecords GradeRecord[]

  @@unique([tenantId, academicYearId, sequence])
  @@index([tenantId, academicYearId])
}

model Grade {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  campusId  String   @db.Uuid
  nameEn    String
  nameAr    String
  level     Int // ordinal, e.g. KG=0, G1=1 ...
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus    Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sections  Section[]
  resources Resource[]

  @@unique([tenantId, campusId, level])
  @@index([tenantId, campusId])
}

model Classroom {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  campusId  String   @db.Uuid
  name      String
  capacity  Int?
  building  String?
  floor     String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus             Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sections           Section[]
  timetableSlots     TimetableSlot[]
  scheduleExceptions ScheduleException[]

  @@unique([tenantId, campusId, name])
  @@index([tenantId, campusId])
}

model Section {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  gradeId     String   @db.Uuid
  classroomId String?  @db.Uuid
  name        String // e.g. "A", "B"
  capacity    Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grade              Grade               @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  classroom          Classroom?          @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  students           Student[]
  teacherSections    TeacherSection[]
  timetableSlots     TimetableSlot[]
  scheduleExceptions ScheduleException[]
  attendance         StudentAttendance[]
  homework           Homework[]
  gradeRecords       GradeRecord[]
  announcements      Announcement[]
  ptmSlots           PtmSlot[]
  resources          Resource[]

  @@unique([tenantId, gradeId, name])
  @@index([tenantId, gradeId])
  @@index([tenantId, classroomId])
}

// ----------------------------------------------------------------------------
// People management
// ----------------------------------------------------------------------------

model Student {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  userId           String?       @unique @db.Uuid
  moeStudentNumber String? // Ministry of Education student number
  nationalId       String? // Jordanian National ID (Raqam Watani)
  firstNameEn      String
  lastNameEn       String
  firstNameAr      String
  lastNameAr       String
  // Full Arab/MoE name parts (given · father · grandfather · family). Optional/back-compat.
  fatherNameEn     String?
  fatherNameAr     String?
  thirdNameEn      String?
  thirdNameAr      String?
  dateOfBirth      DateTime?     @db.Date
  gender           Gender?
  sectionId        String?       @db.Uuid
  qrCode           String        @unique
  status           StudentStatus @default(ACTIVE)
  enrollmentDate   DateTime      @default(now()) @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?     @db.Timestamptz(6)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  section        Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parentLinks    ParentStudent[]
  attendance     StudentAttendance[]
  behaviorLogs   BehaviorLog[]
  gradeRecords   GradeRecord[]
  charges        Charge[]
  transactions   Transaction[]
  leaveRequests  LeaveRequest[]
  ptmBookings    PtmBooking[]
  documents      Document[]
  achievements   StudentAchievement[]
  gamification   StudentGamification?
  busAssignments StudentBusAssignment[]
  bookLoans      BookLoan[]
  medicalRecord  StudentMedicalRecord?
  clinicVisits   ClinicVisit[]

  @@unique([tenantId, moeStudentNumber])
  @@unique([tenantId, nationalId])
  @@index([tenantId])
  @@index([tenantId, sectionId])
  @@index([tenantId, status])
}

model Parent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String?   @unique @db.Uuid
  firstNameEn String
  lastNameEn  String
  firstNameAr String
  lastNameAr  String
  phone       String?
  nationalId  String?
  occupation  String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentLinks ParentStudent[]

  @@unique([tenantId, nationalId])
  @@index([tenantId])
}

model Teacher {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  userId         String?          @unique @db.Uuid
  employeeNumber String?
  firstNameEn    String
  lastNameEn     String
  firstNameAr    String
  lastNameAr     String
  specialization String?
  status         EmploymentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?        @db.Timestamptz(6)

  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  sections               TeacherSection[]
  timetableSlots         TimetableSlot[]
  exceptionReplacements  ScheduleException[] @relation("ExceptionTeacher")
  exceptionSubstitutions ScheduleException[] @relation("ExceptionSubstitute")
  attendance             TeacherAttendance[]
  ptmSlots               PtmSlot[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
}

model Employee {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  userId      String?          @unique @db.Uuid
  firstNameEn String
  lastNameEn  String
  firstNameAr String
  lastNameAr  String
  jobTitle    String
  department  String?
  status      EmploymentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?        @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model ParentStudent {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  parentId  String         @db.Uuid
  studentId String         @db.Uuid
  relation  ParentRelation
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

model TeacherSection {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  teacherId String   @db.Uuid
  sectionId String   @db.Uuid
  subject   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teacherId])
  @@index([sectionId])
}

// ----------------------------------------------------------------------------
// Identity & Access (IAM)
// ----------------------------------------------------------------------------

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @db.Uuid
  firebaseUid        String?    @unique
  email              String
  phone              String?
  nationalId         String? // Jordanian National ID (Raqam Watani)
  firstNameEn        String?
  lastNameEn         String?
  firstNameAr        String?
  lastNameAr         String?
  status             UserStatus @default(INVITED)
  // Local-login credential (Argon2/bcrypt hash). Null for Firebase-only accounts.
  passwordHash       String?
  passwordUpdatedAt  DateTime?  @db.Timestamptz(6)
  mustChangePassword Boolean    @default(true)
  lastLoginAt        DateTime?  @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?  @db.Timestamptz(6)

  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles              UserRole[]
  refreshTokens          RefreshToken[]
  passwordResets         PasswordResetToken[]
  studentProfile         Student?
  parentProfile          Parent?
  teacherProfile         Teacher?
  employeeProfile        Employee?
  studentAttendanceMarks StudentAttendance[]  @relation("StudentAttendanceMarkedBy")
  teacherAttendanceMarks TeacherAttendance[]  @relation("TeacherAttendanceMarkedBy")
  notifications          Notification[]
  deviceTokens           DeviceToken[]
  auditLogs              AuditLog[]           @relation("AuditActor")
  leaveRequestsMade      LeaveRequest[]       @relation("LeaveRequestedBy")
  leaveRequestsReviewed  LeaveRequest[]       @relation("LeaveReviewedBy")
  ptmSlotsCreated        PtmSlot[]            @relation("PtmSlotCreatedBy")
  ptmBookingsMade        PtmBooking[]         @relation("PtmBookedBy")
  documentsUploaded      Document[]           @relation("DocumentUploadedBy")
  resourcesUploaded      Resource[]           @relation("ResourceUploadedBy")
  achievementsAwarded    StudentAchievement[] @relation("AchievementAwardedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, nationalId])
  @@index([tenantId])
  @@index([tenantId, status])
}

// Roles are tenant-scoped for the School plane; Platform-plane system roles use a
// null tenantId. Uniqueness is enforced per (tenantId, key).
model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  key       RoleKey
  scope     RoleScope
  isSystem  Boolean   @default(true)
  nameEn    String?
  nameAr    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Global permission catalog (not tenant-scoped). Seeded from @munaxa/domain.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. "attendance:create"
  category    String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@index([roleId])
}

// ----------------------------------------------------------------------------
// Auth: rotating refresh tokens (hashed) with reuse detection
// ----------------------------------------------------------------------------

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  // SHA-256 of the opaque refresh token; the raw token is never stored.
  tokenHash         String    @unique
  // Token family for rotation/reuse detection. Reuse of a rotated token revokes the family.
  familyId          String    @db.Uuid
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  // Set when this token was rotated; pointing at its successor.
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
}

// ----------------------------------------------------------------------------
// Audit (append-only)
// ----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid // null for platform-level events
  actorUserId String?  @db.Uuid
  actorRole   String?
  onBehalfOf  String?  @db.Uuid // set for support impersonation
  action      String // e.g. "transaction.create"
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?
  userAgent   String?
  traceId     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId])
}

// ----------------------------------------------------------------------------
// Timetable engine
// ----------------------------------------------------------------------------

// A recurring weekly class slot for a section. The REGULAR set is the master timetable;
// the RAMADAN set is used when Ramadan mode is active (see TimetableConfig). Times are
// "HH:MM" (24h) local school time.
model TimetableSlot {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  sectionId    String       @db.Uuid
  scheduleType ScheduleType @default(REGULAR)
  dayOfWeek    DayOfWeek
  periodIndex  Int
  startTime    String // "HH:MM"
  endTime      String // "HH:MM"
  subject      String
  teacherId    String?      @db.Uuid
  classroomId  String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher   Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  classroom Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sectionId, scheduleType, dayOfWeek, periodIndex])
  @@index([tenantId, sectionId])
}

// A date-specific override of the master timetable: a cancelled period, a substitute teacher,
// a replaced subject, or a whole-day holiday (periodIndex null + sectionId null => school-wide).
model ScheduleException {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @db.Uuid
  date                DateTime      @db.Date
  sectionId           String?       @db.Uuid
  periodIndex         Int?
  type                ExceptionType
  subject             String?
  teacherId           String?       @db.Uuid // replacement teacher
  substituteTeacherId String?       @db.Uuid
  classroomId         String?       @db.Uuid
  note                String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section    Section?   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher    Teacher?   @relation("ExceptionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  substitute Teacher?   @relation("ExceptionSubstitute", fields: [substituteTeacherId], references: [id], onDelete: SetNull)
  classroom  Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([tenantId, sectionId, date])
}

// Per-campus timetable settings, notably Ramadan mode and its active window.
model TimetableConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  campusId           String    @unique @db.Uuid
  ramadanModeEnabled Boolean   @default(false)
  ramadanStartDate   DateTime? @db.Date
  ramadanEndDate     DateTime? @db.Date
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Attendance
// ----------------------------------------------------------------------------

// Student attendance. periodIndex 0 = daily/homeroom; >0 = per-period. Unique per
// (student, date, period) so offline re-sync is idempotent (upsert on that key).
model StudentAttendance {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  studentId   String           @db.Uuid
  sectionId   String           @db.Uuid
  date        DateTime         @db.Date
  periodIndex Int              @default(0)
  status      AttendanceStatus
  method      AttendanceMethod @default(MANUAL)
  note        String?
  markedById  String?          @db.Uuid
  // Client-generated id from the offline queue (audit/debug; idempotency uses the unique key).
  clientRef   String?
  recordedAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("StudentAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, date, periodIndex])
  @@index([tenantId, sectionId, date])
  @@index([tenantId, studentId, date])
}

model TeacherAttendance {
  id         String                  @id @default(uuid()) @db.Uuid
  tenantId   String                  @db.Uuid
  teacherId  String                  @db.Uuid
  date       DateTime                @db.Date
  status     TeacherAttendanceStatus
  checkInAt  DateTime?               @db.Timestamptz(6)
  note       String?
  markedById String?                 @db.Uuid
  recordedAt DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime                @updatedAt @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher  Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("TeacherAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, teacherId, date])
  @@index([tenantId, date])
}

// ----------------------------------------------------------------------------
// Academics
// ----------------------------------------------------------------------------

model Homework {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  sectionId    String    @db.Uuid
  subject      String
  title        String
  description  String?
  dueDate      DateTime  @db.Date
  assignedById String?   @db.Uuid // teacher/user; plain ref (no FK relation)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section     Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attachments HomeworkAttachment[]

  @@index([tenantId, sectionId])
  @@index([tenantId, dueDate])
}

// Attachment metadata. Files live in S3 and are uploaded directly via pre-signed URLs;
// only the object key + metadata are stored here.
model HomeworkAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  homeworkId   String   @db.Uuid
  fileName     String
  fileKey      String // S3 object key
  contentType  String
  size         Int
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([tenantId, homeworkId])
}

model BehaviorLog {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  studentId    String       @db.Uuid
  type         BehaviorType
  category     String?
  title        String
  description  String?
  points       Int          @default(0)
  date         DateTime     @db.Date
  recordedById String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, date])
}

// A graded assessment. Unique per (student, subject, assessment, semester) so grade import
// is idempotent (re-importing updates the score rather than duplicating).
model GradeRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  studentId  String   @db.Uuid
  sectionId  String?  @db.Uuid
  semesterId String?  @db.Uuid
  subject    String
  assessment String // e.g. "Midterm", "Quiz 1"
  score      Decimal  @db.Decimal(6, 2)
  maxScore   Decimal  @db.Decimal(6, 2)
  weight     Decimal? @db.Decimal(5, 2)
  gradedById String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, subject, assessment, semesterId])
  @@index([tenantId, studentId])
  @@index([tenantId, sectionId])
}

// ----------------------------------------------------------------------------
// Finance (no online gateway: payments are recorded; CliQ/e-wallet via receipt upload)
// ----------------------------------------------------------------------------

model FeePlan {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  name        String
  description String?
  amount      Decimal       @db.Decimal(12, 3) // JOD
  recurrence  FeeRecurrence @default(ONE_TIME)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charges Charge[]

  @@index([tenantId])
}

model Charge {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  studentId   String       @db.Uuid
  feePlanId   String?      @db.Uuid
  description String
  amount      Decimal      @db.Decimal(12, 3)
  dueDate     DateTime?    @db.Date
  status      ChargeStatus @default(PENDING)
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feePlan      FeePlan?      @relation(fields: [feePlanId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

// A payment toward a student's charges. CliQ/e-wallet payments are uploaded as receipts
// (receiptKey in S3) and start PENDING until a FinanceOfficer verifies them.
model Transaction {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  studentId    String            @db.Uuid
  chargeId     String?           @db.Uuid
  amount       Decimal           @db.Decimal(12, 3)
  method       PaymentMethod
  reference    String? // e.g. CliQ reference
  receiptKey   String? // S3 object key for an uploaded receipt
  status       TransactionStatus @default(PENDING)
  note         String?
  recordedById String?           @db.Uuid
  verifiedById String?           @db.Uuid
  verifiedAt   DateTime?         @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  charge  Charge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

// ----------------------------------------------------------------------------
// Communication
// ----------------------------------------------------------------------------

model Announcement {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  title         String
  body          String
  audience      AnnouncementAudience @default(ALL)
  sectionId     String?              @db.Uuid
  publishedById String?              @db.Uuid
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section       Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([tenantId, createdAt])
}

// A per-user item in the in-app notification center. Fanned out from announcements/events.
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  userId         String    @db.Uuid
  title          String
  body           String
  category       String?
  data           Json?
  announcementId String?   @db.Uuid
  readAt         DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, createdAt])
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now()) @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

// Per-tenant feature flags (e.g. the WhatsApp bridge). Disabled by default.
model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Parent portal (Phase 11)
// ----------------------------------------------------------------------------

// A parent-submitted leave (planned) or absence (excuse) request for one of their children.
// Reviewed (approved/rejected) by school staff holding leave:approve.
model LeaveRequest {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  studentId     String             @db.Uuid
  requestedById String?            @db.Uuid
  type          LeaveRequestType
  status        LeaveRequestStatus @default(PENDING)
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  reason        String
  reviewedById  String?            @db.Uuid
  reviewNote    String?
  reviewedAt    DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User?   @relation("LeaveRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy  User?   @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

// A Parent-Teacher Meeting slot offered by a teacher (optionally for a specific section).
model PtmSlot {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  teacherId   String        @db.Uuid
  sectionId   String?       @db.Uuid
  startsAt    DateTime      @db.Timestamptz(6)
  endsAt      DateTime      @db.Timestamptz(6)
  location    String?
  capacity    Int           @default(1)
  status      PtmSlotStatus @default(OPEN)
  notes       String?
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher   Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section   Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("PtmSlotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bookings  PtmBooking[]

  @@index([tenantId])
  @@index([tenantId, teacherId])
  @@index([tenantId, startsAt])
}

// A parent's booking of a PTM slot for one of their children.
model PtmBooking {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  slotId     String           @db.Uuid
  studentId  String           @db.Uuid
  bookedById String?          @db.Uuid
  status     PtmBookingStatus @default(BOOKED)
  note       String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slot     PtmSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bookedBy User?   @relation("PtmBookedBy", fields: [bookedById], references: [id], onDelete: SetNull)

  @@unique([slotId, studentId])
  @@index([tenantId])
  @@index([tenantId, slotId])
  @@index([tenantId, studentId])
}

// Document vault: secure files attached to a student (report cards, certificates, medical, IDs).
// Uploaded by parents (for their children) or staff, stored in S3 via the StorageService.
model Document {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  studentId    String           @db.Uuid
  title        String
  category     DocumentCategory @default(OTHER)
  fileKey      String
  fileName     String
  contentType  String
  size         Int
  uploadedById String?          @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  deletedAt    DateTime?        @db.Timestamptz(6)

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, studentId])
}

// ----------------------------------------------------------------------------
// Student app (Phase 12): resource library + gamification
// ----------------------------------------------------------------------------

// A learning resource visible to students. Scoped to a section, a whole grade, or the whole
// school (both null). FILE/DOCUMENT live in S3; LINK/VIDEO deep-link out (not an LMS).
model Resource {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  sectionId    String?      @db.Uuid
  gradeId      String?      @db.Uuid
  subject      String?
  title        String
  description  String?
  type         ResourceType @default(LINK)
  url          String?
  fileKey      String?
  fileName     String?
  contentType  String?
  size         Int?
  uploadedById String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?    @db.Timestamptz(6)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section    Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  grade      Grade?   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("ResourceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, sectionId])
  @@index([tenantId, gradeId])
}

// A per-tenant achievement/badge definition. ATTENDANCE_* are auto-awarded when a student's
// streak/total reaches `threshold`; ACADEMIC/GENERAL are awarded manually by staff.
model Achievement {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  key         String
  nameEn      String
  nameAr      String
  description String?
  icon        String?
  category    AchievementCategory @default(GENERAL)
  points      Int                 @default(0)
  threshold   Int?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentAchievements StudentAchievement[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

// A student's earned achievement (idempotent per student+achievement).
model StudentAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  studentId     String   @db.Uuid
  achievementId String   @db.Uuid
  awardedById   String?  @db.Uuid
  note          String?
  earnedAt      DateTime @default(now()) @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  awardedBy   User?       @relation("AchievementAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)

  @@unique([studentId, achievementId])
  @@index([tenantId])
  @@index([tenantId, studentId])
}

// Per-student gamification rollup: points, level, and attendance streaks (recomputed on sync).
model StudentGamification {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  studentId     String    @unique @db.Uuid
  totalPoints   Int       @default(0)
  level         Int       @default(1)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastSyncedAt  DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Advanced modules (Phase 14) — feature-flagged, OFF by default
// ----------------------------------------------------------------------------

// --- Bus tracking -----------------------------------------------------------
model BusRoute {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  description String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buses       Bus[]
  stops       BusStop[]
  assignments StudentBusAssignment[]

  @@index([tenantId])
}

model Bus {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  routeId     String?   @db.Uuid
  plateNumber String
  label       String?
  capacity    Int?
  driverName  String?
  driverPhone String?
  lastLat     Float?
  lastLng     Float?
  lastSeenAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route  BusRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, plateNumber])
  @@index([tenantId])
}

model BusStop {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  routeId    String   @db.Uuid
  name       String
  sequence   Int      @default(0)
  lat        Float?
  lng        Float?
  pickupTime String? // "HH:MM"
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route       BusRoute               @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments StudentBusAssignment[]

  @@index([tenantId])
  @@index([tenantId, routeId])
}

model StudentBusAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  studentId String   @db.Uuid
  routeId   String   @db.Uuid
  stopId    String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop    BusStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@unique([studentId, routeId])
  @@index([tenantId])
  @@index([tenantId, routeId])
}

// --- Library management ------------------------------------------------------
model LibraryBook {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  title           String
  author          String?
  isbn            String?
  category        String?
  copiesTotal     Int       @default(1)
  copiesAvailable Int       @default(1)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans  BookLoan[]

  @@index([tenantId])
}

model BookLoan {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  bookId       String         @db.Uuid
  studentId    String?        @db.Uuid
  borrowerName String?
  status       BookLoanStatus @default(ACTIVE)
  borrowedAt   DateTime       @default(now()) @db.Timestamptz(6)
  dueDate      DateTime       @db.Date
  returnedAt   DateTime?      @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book    LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, bookId])
  @@index([tenantId, status])
}

// --- Inventory management ----------------------------------------------------
model InventoryItem {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  name         String
  sku          String?
  category     String?
  unit         String?
  quantity     Int       @default(0)
  reorderLevel Int?
  location     String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model InventoryTransaction {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  itemId       String           @db.Uuid
  type         InventoryTxnType
  quantity     Int
  reason       String?
  recordedById String?          @db.Uuid // plain ref (no FK relation)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, itemId])
}

// --- School clinic -----------------------------------------------------------
model StudentMedicalRecord {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  studentId         String   @unique @db.Uuid
  bloodType         String?
  allergies         String?
  chronicConditions String?
  medications       String?
  emergencyContact  String?
  notes             String?
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ClinicVisit {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  studentId    String        @db.Uuid
  reason       String
  symptoms     String?
  treatment    String?
  temperature  Decimal?      @db.Decimal(4, 1)
  outcome      ClinicOutcome @default(RESOLVED)
  recordedById String?       @db.Uuid // plain ref (no FK relation)
  visitedAt    DateTime      @default(now()) @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, studentId])
}
