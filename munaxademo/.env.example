# ──────────────────────────────────────────────────────────────────────────
# Munaxa Demo — environment.
# There is NO database and NO external service here. The only secret is the
# HMAC key used to sign the demo session cookie. Everything else is in-memory.
# ──────────────────────────────────────────────────────────────────────────

# Secret used to sign the httpOnly demo session cookie (HMAC-SHA256).
# Generate one with:  openssl rand -base64 48
# If unset, a dev-only fallback is used (NOT for production).
DEMO_SESSION_SECRET=

# Absolute session lifetime in minutes (default 120). After this the cookie is
# rejected and the user must sign in again — which fully resets demo data.
DEMO_SESSION_TTL_MINUTES=120
