# ============================================================================
# Munaxa API — environment example. Copy to .env. NEVER commit real secrets.
# ============================================================================

NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=api
API_VERSION=v1

# --- Database (Prisma / PostgreSQL) ---
# Runtime: restricted, NON-superuser, NOBYPASSRLS role so Row-Level Security is enforced.
DATABASE_URL=postgresql://munaxa_app:munaxa_app_dev@localhost:5432/munaxa?schema=public
# Migrations/introspection: privileged schema owner (used by `prisma migrate`).
DIRECT_DATABASE_URL=postgresql://munaxa:munaxa_local_dev@localhost:5432/munaxa?schema=public

# --- Redis (cache, rate limiting, queues) ---
REDIS_URL=redis://localhost:6379

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000

# --- JWT (issued by the API; Phase 3) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=2592000

# --- Firebase Admin (Auth verification; Phase 3) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- AWS S3 (file storage) ---
AWS_REGION=eu-central-1
AWS_S3_BUCKET=munaxa-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For LocalStack in local dev:
AWS_S3_ENDPOINT=http://localhost:4566

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@munaxa.app

# --- Security ---
# '1' enables the HIBP k-anonymity breach check on password set/change (fail-open; recommended in production).
PASSWORD_BREACH_CHECK=

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# E-invoicing (Phase 16) — secrets master key (32 bytes, base64), required only when a
# tenant enables e-invoicing. Generate: openssl rand -base64 32
EINVOICE_MASTER_KEY=
# Set to 0 to disable the submission worker (tests)
EINVOICE_WORKER=

# SMS gateway for late-payment reminders (no-op until both are set)
SMS_PROVIDER=
SMS_API_KEY=
