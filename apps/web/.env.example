# Copy to .env.local for `pnpm dev`. Without RESEND_API_KEY, form submissions are logged instead
# of emailed (development only; production refuses rather than dropping leads).
RESEND_API_KEY=
EMAIL_FROM=Munaxa Website <contactus@mail.munaxa.com>
EMAIL_TO=info@munaxa.com
EMAIL_WELCOME_FROM_ADDRESS=no-reply@mail.munaxa.com

# Search-console ownership tokens (the `content` value of each meta tag). Inlined at build time.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
