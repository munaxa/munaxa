{
  "name": "@corporate/web",
  "version": "0.1.0",
  "private": true,
  "description": "Munaxa Corporate — the company website: product showcase, pricing, about, careers and contact. Consumes the shared design system from @munaxa/*.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "prebuild": "pnpm run sync:brand",
    "build": "next build",
    "predev": "pnpm run sync:brand",
    "sync:brand": "munaxa-sync-brand group public && munaxa-sync-brand school public && munaxa-sync-brand work public && munaxa-sync-brand docs public",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "dependencies": {
    "@munaxa/icons": "^1.1.0",
    "@munaxa/platform": "^1.3.0",
    "@munaxa/theme": "^1.1.0",
    "@munaxa/ui": "^1.1.0",
    "next": "15.1.12",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "15.1.12",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
