{
  "name": "@munaxa/icons",
  "version": "0.1.0",
  "private": true,
  "description": "The single icon source for the Munaxa platform. Re-exports the curated lucide-react set so every app and @munaxa/ui share one icon library at one version.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.cache/tsc-typecheck.tsbuildinfo",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "workspace:*",
    "@munaxa/config-typescript": "workspace:*",
    "@types/react": "^19.0.2",
    "eslint": "^9.17.0",
    "react": "^19.0.0",
    "typescript": "^5.7.3"
  }
}
