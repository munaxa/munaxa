{
  "name": "@munaxa/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "The single source of truth for every Munaxa design token (colors, typography, spacing, radius, elevation, border, motion, transitions, z-index, breakpoints). Consumed by @munaxa/config-tailwind, @munaxa/ui and every Munaxa application.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./css/tokens.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.cache/tsc-typecheck.tsbuildinfo",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "workspace:*",
    "@munaxa/config-typescript": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3"
  }
}
