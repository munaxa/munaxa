# ============================================================================
# Munaxa Landing Page — environment example. Copy to .env.local (dev) or configure
# as environment variables in your hosting platform (production).
# NEVER commit a real .env file. NEXT_PUBLIC_* values are exposed to the browser.
# ============================================================================

NODE_ENV=development

# Public site URL — used for canonical URLs, sitemap.xml, robots.txt, and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=https://www.munaxa.com

# --- Database (contact inquiries) ---
# Dedicated table for this app (see db/migrations/001_create_contact_inquiries.sql).
# Can point at the same Postgres instance as the main School OS (different schema/role)
# or a separate database. If unset, submissions are still emailed but not persisted.
LANDING_DATABASE_URL=postgresql://munaxa_landing:change-me@localhost:5432/munaxa_landing
LANDING_DATABASE_SSL=false

# --- Email (Resend) ---
# Used to send the visitor acknowledgment email and the internal notification to
# info@munaxa.com. If unset, emails are skipped (and logged) — useful for local dev.
RESEND_API_KEY=
EMAIL_FROM="Munaxa <no-reply@munaxa.com>"

# --- Optional CAPTCHA (Cloudflare Turnstile) ---
# Leave both empty to disable CAPTCHA. Set both to enable bot protection on the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability (optional) ---
SENTRY_DSN=
