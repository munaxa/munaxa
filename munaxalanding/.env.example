# ============================================================================
# Munaxa Landing Page — environment example. Copy to .env.local (dev) or configure
# as environment variables in your hosting platform (production).
# NEVER commit a real .env file. NEXT_PUBLIC_* values are exposed to the browser.
# ============================================================================

NODE_ENV=development

# Public site URL — used for canonical URLs, sitemap.xml, robots.txt, and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=https://www.munaxa.com

# --- Database (contact inquiries) ---
# Submissions are upserted (by email) into the `early_access_requests` table of the shared
# Munaxa Supabase project — see db/migrations/002_add_contact_fields_to_early_access_requests.sql.
# SUPABASE_SERVICE_ROLE_KEY is a secret: server-side only, NEVER prefix with NEXT_PUBLIC_ and
# never commit a real value. If either var is unset, submissions are still emailed but not
# persisted.
SUPABASE_URL=https://fngkpuyvzqemkqnenryq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
# Used to send the visitor acknowledgment email and the internal notification to
# info@munaxa.com. If unset, emails are skipped (and logged) — useful for local dev.
RESEND_API_KEY=
EMAIL_FROM="Munaxa <no-reply@munaxa.com>"

# --- Optional CAPTCHA (Cloudflare Turnstile) ---
# Leave both empty to disable CAPTCHA. Set both to enable bot protection on the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability (optional) ---
SENTRY_DSN=

# ============================================================================
# Cloudflare Workers deployment (not read by the app — used by `pnpm deploy` /
# CI). Set these as repository secrets, NOT in this file.
#   CLOUDFLARE_API_TOKEN    — "Edit Cloudflare Workers" template token
#   CLOUDFLARE_ACCOUNT_ID   — your Cloudflare account ID
# Runtime env vars/secrets above (SUPABASE_*, RESEND_API_KEY, EMAIL_FROM,
# TURNSTILE_SECRET_KEY, NEXT_PUBLIC_*, SENTRY_DSN) must also be configured as
# Worker secrets/vars — see README.md "Deploying to Cloudflare Workers".
# ============================================================================
