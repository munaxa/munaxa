# ============================================================================
# Munaxa Landing Page — environment example. Copy to .env.local (dev) or configure
# as environment variables in your hosting platform (production).
# NEVER commit a real .env file. NEXT_PUBLIC_* values are exposed to the browser.
# ============================================================================

NODE_ENV=development

# Public site URL — used for canonical URLs, sitemap.xml, robots.txt, and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=https://www.munaxa.com

# --- Demo app ---
# Public URL of the standalone Munaxa demo app's "Request a Demo" form (the munaxademo app,
# deployed separately on Cloudflare). The landing page's "Request a Demo" / "Book a Demo"
# buttons link here.
NEXT_PUBLIC_DEMO_URL=https://demo.munaxa.com/request-demo

# --- Email (Resend) ---
# Used to send the visitor acknowledgment email and the internal notification to
# info@munaxa.com. If unset, emails are skipped (and logged) — useful for local dev.
RESEND_API_KEY=
EMAIL_FROM="Munaxa <no-reply@munaxa.com>"
# Sender for the internal contact-form notification delivered to info@munaxa.com.
# Domain must be verified in Resend.
EMAIL_CONTACT_FROM="Munaxa Contact <contactus@munaxa.com>"

# --- Optional CAPTCHA (Cloudflare Turnstile) ---
# Leave both empty to disable CAPTCHA. Set both to enable bot protection on the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability (optional) ---
SENTRY_DSN=

# ============================================================================
# Cloudflare Workers deployment (not read by the app — used by `pnpm deploy` /
# CI). Set these as repository secrets, NOT in this file.
#   CLOUDFLARE_API_TOKEN    — "Edit Cloudflare Workers" template token
#   CLOUDFLARE_ACCOUNT_ID   — your Cloudflare account ID
# Runtime env vars/secrets above (RESEND_API_KEY, EMAIL_FROM, TURNSTILE_SECRET_KEY,
# NEXT_PUBLIC_*, SENTRY_DSN) must also be configured as Worker secrets/vars — see
# README.md "Deploying to Cloudflare Workers".
# ============================================================================
